@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    //ViewData["Title"] = "RFQ";

    ViewBag.CurrentPageName = PageNames.CV_Details;

}
@section scripts
    {
    <script src="~/view-resources/Views/CV/Details.js" asp-append-version="true"></script>
    <script src="~/js/toWords.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>
                            <input id="Id" class="form-control font-weight-bold" disabled type="hidden" name="Id" value="@ViewBag.Id" required>
                            Check Voucher Details

                            <span id="StatusBadge"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    <button id="btnPrint" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i>&nbsp; Print</button>
                </div>
            </div>
        </div>
    </div>
</div>

