                                                            <input id="Code" type="hidden" name="Code">
                                                            <input id="Series" type="hidden" name="SeriesTypeId">
                                                            <input id="StatusId" type="hidden" name="StatusId">
                                                            <input id="QuotationCode" type="hidden" name="QuotationCode">
                                                            <input id="RevisionNo" type="hidden" name="RevisionNo">
                                                            <input id="Prefix" type="hidden" name="Prefix">
                                                        </div>
                                                    </div>
                                                </div>


