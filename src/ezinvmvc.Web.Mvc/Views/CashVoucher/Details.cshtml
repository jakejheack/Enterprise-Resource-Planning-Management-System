@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    //ViewData["Title"] = "CashVoucher";

    ViewBag.CurrentPageName = PageNames.CashVoucher_Details;

}
@section scripts
    {
    <script src="~/view-resources/Views/CashVoucher/Details.js" asp-append-version="true"></script>
    <script src="~/js/toWords.js" asp-append-version="true"></script>
}


<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>
                            <input id="Id" class="form-control font-weight-bold" disabled type="hidden" name="Id" value="@ViewBag.Id" required>
                            <input id="StatusId" class="form-control font-weight-bold" type="hidden" name="StatusId" required>
                            Cash Voucher Details
                            <span id="StatusBadge"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    <button id="btnPrint" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i>&nbsp; Print</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body card-block">
                        <form id="CashVoucherForm" name="CashVoucherForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
                            <div class="row clearfix">
                                <div class="col-md-12  col-xl-12">
                                    <div class="card">
                                        <div class="card-body card-block">
                                            <div class="row">
                                                <div class="col-md-6  col-xl-6" hidden>
                                                    <div class="form-group">
                                                        <label for="CashVoucher">Company</label>
                                                        <div class="input-group">
                                                            <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6  col-xl-6">
                                                    <div class="form-group">
                                                        <label for="CashVoucher">Series</label>
                                                        <div class="input-group">
                                                            @*<select name="SeriesTypeId" id="SeriesTypeId" class="selectpicker form-control" required></select>*@
                                                            <input type="text" id="SeriesTypeId" name="SeriesTypeId" disabled class="form-control" required>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label>Date</label>
                                                        <div class="input-group date" data-provide="datepicker" disabled>
                                                            <input type="text" id="TransactionTime" name="TransactionTime" class="form-control date-picker" value='@System.DateTime.Now.ToString("MM/dd/yyyy")' required disabled>
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-calendar"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6  col-xl-6">
                                                    <div class="form-group">
                                                        <label>Party</label>
                                                        <select id="PartyType" name="PartyType" class="selectpicker form-control">
                                                            <option value="105">Clients</option>
                                                            <option value="108">Employees</option>
                                                            <option value="200">Vendors</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-6  col-xl-6">
                                                    <div class="form-group">
                                                        <label>&nbsp;</label>
                                                        <input type="hidden" id="PartyId" name="PartyId" required>
                                                        <input type="hidden" id="PartyCode" name="PartyCode" required>
                                                        <input type="hidden" id="PartyName" name="PartyName" required>
                                                        <input type="text" id="PartyClient" name="PartyClient" placeholder="Type Client to search" class="form-control">
                                                        <input type="text" id="PartyEmployee" name="PartyEmployee" placeholder="Type Employee to search" class="form-control">
                                                        <input type="text" id="PartyVendor" name="PartyVendor" placeholder="Type Vendor to search" class="form-control">
                                                    </div>

                                                </div>

                                                <div class="col-md-6 col-xl-6" hidden>
                                                    <div class="form-group">
                                                        <label for="CashVoucher">Finance Book</label>
                                                        <input type="hidden" id="LeadId" name="LeadId" required>
                                                        <input type="hidden" id="LeadCode" name="LeadCode" required>
                                                        <input type="text" id="Lead" name="Lead" placeholder="Finance book to search" class="form-control" required>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6" hidden>
                                                    <div class="form-group">
                                                        <label for="txtClient">Company Name</label>
                                                        <input type="hidden" id="ClientId" name="ClientId" required>
                                                        <input type="text" id="ClientName" name="Client" disabled class="form-control">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 col-xl-6 ">
                                                    <div class="form-group">
                                                        <label for="txtNotes">Notes</label>
                                                        <textarea id="Notes" name="Notes" class="form-control" rows="4" maxlength="328" disabled></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row clearfix">
                                <div class="col-md-12  col-xl-12">
                                    <div class="card">
                                        <div class="card-body card-block">
                                            <div class="row">
                                                <div class="col-md-4 col-xl-4">
                                                    <div class="form-group">
                                                        <label for="txtClient">Check Name</label>
                                                        <input id="CheckName" class="form-control" type="text" name="CheckName" required>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">

                                                <div class="col-md-4  col-xl-4">
                                                    <div class="form-group">
                                                        <label for="txtClient">Check Number</label>
                                                        <input id="CheckNumber" class="form-control" type="text" name="CheckNumber" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-4  col-xl-4">
                                                    <div class="form-group">
                                                        <label>Check Date</label>
                                                        <div class="input-group date" data-provide="datepicker" disabled>
                                                            <input type="text" name="CheckDate" id="CheckDate" class="form-control date-picker" value='@System.DateTime.Now.ToString("MM/dd/yyyy")' required>
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-calendar"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4  col-xl-4">
                                                    <div class="form-group">
                                                        <label for="txtClient">Amount</label>
                                                        <input id="PaidAmount" class="form-control text-right" type="text" name="PaidAmount" value="0" required>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row clearfix">
                                <div class="col-md-12  col-xl-12">
                                    <div class="card">
                                        <div class="card-body card-block">
                                            <div class="row">
                                                <div class="col-md-12  col-xl-12">
                                                    <div class="form-group">
                                                        <table id="ItemsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                            <thead>
                                                                <tr>
                                                                    <th width="5%">#</th>@*0*@
                                                                    <th width="30%">Acount</th>@*1*@
                                                                    <th width="30%">Party</th>@*2*@
                                                                    <th width="15%">Debit</th>@*3*@
                                                                    <th width="15%">Credit</th>@*4*@
                                                                    <th width="5%"></th>@*5 Action*@
                                                                    <th></th>@*6 AccountId*@
                                                                    <th></th>@*7 Account*@
                                                                    <th></th>@*8 PartyId*@
                                                                    <th></th>@*9 Party*@
                                                                    <th></th>@*10 Debit*@
                                                                    <th></th>@*11 Credit*@
                                                                    <th></th>@*12 PartyType*@
                                                                    <th></th>@*13 PartyCode*@
                                                                    <th></th>@*14 Id*@

                                                                </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-xl-12">
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">

                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="row form-group">
                                                            <div class="col-md-6 col-xl-6 text-right" style="padding-top:5px">
                                                                <label for="email-input" class=" form-control-label"><strong>Debit Total</strong></label>
                                                            </div>
                                                            <div class="col-md-6 col-xl-6">
                                                                <input type="text" id="DebitTotal" disabled name="DebitTotal" class="form-control text-right font-weight-bold" required>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">

                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="row form-group">
                                                            <div class="col-md-6 col-xl-6 text-right" style="padding-top:5px">
                                                                <label for="email-input" class=" form-control-label"><strong>Credit Total</strong></label>
                                                            </div>
                                                            <div class="col-md-6 col-xl-6">
                                                                <input type="text" id="CreditTotal" disabled name="CreditTotal" class="form-control text-right font-weight-bold" required>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row clearfix" >
                                <div class="col-md-12  col-xl-12">
                                    <div class="form-group">
                                        @*<input type="text" id="DateFrom" name="DateFrom" class="form-control input-sm form-control-sm date-picker" placeholder="mm/dd/yyyy" required>
                                            <input type="text" id="DateTo" name="DateTo" class="form-control input-sm form-control-sm date-picker" placeholder="mm/dd/yyyy" required>*@
                                        <table id="GLTable" class="display table dt-responsive nowrap" style="width: 100%; ">
                                            <thead>
                                                <tr>
                                                    <th width="5%">#</th>@*0*@
                                                    <th width="15%"></th>@*1*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%">Id</th>@*3 Check Number*@
                                                    <th width="10%">AccountId</th>@*4 Price*@

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th width="5%">#</th>@*0*@
                                                    <th width="15%"></th>@*1*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%">Id</th>@*3 Check Number*@
                                                    <th width="10%">AccountId</th>@*4 Price*@

                                                </tr>
                                            </tfoot>
                                        </table>
                                        <table id="GLTempTable" class="display table dt-responsive nowrap" style="width: 100%; ">
                                            <thead>
                                                <tr>
                                                    <th width="5%">#</th>@*0*@
                                                    <th width="15%"></th>@*1*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%">Id</th>@*3 Check Number*@
                                                    <th width="10%">AccountId</th>@*4 Price*@

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th width="5%">#</th>@*0*@
                                                    <th width="15%"></th>@*1*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%"></th>@*2*@
                                                    <th width="10%">Id</th>@*3 Check Number*@
                                                    <th width="10%">AccountId</th>@*4 Price*@

                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="PrintModal" tabindex="-1" role="dialog" aria-labelledby="PrintModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title text-success">
                    <span>Print Details</span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="row">

                </div>
                <div class="row">
                    <div class="col-md-4  col-xl-4">
                        <div class="form-group">
                            <label>Prepared by:</label>
                            <input id="SalesCoordinatorId" type="hidden" name="SalesCoordinatorId">
                            <input id="SalesCoordinatorEmail" type="hidden" name="SalesCoordinatorEmail">
                            <input id="SalesCoordinatorContactNum" type="hidden" name="SalesCoordinatorContactNum">
                            <input id="SalesCoordinator" class="form-control" type="text" name="SalesCoordinator" placeholder="Type name here">
                        </div>
                    </div>
                    <div class="col-md-4  col-xl-4">
                        <div class="form-group">
                            <label for="Product">Checked by:</label>
                            <input id="IDGId" type="hidden" name="IDGId">
                            <input id="IDGEmail" type="hidden" name="IDGEmail">
                            <input id="IDGContactNum" type="hidden" name="IDGContactNum">
                            <input id="IDG" class="form-control" type="text" name="IDG" placeholder="Type name here">
                        </div>
                    </div>
                    <div class="col-md-4  col-xl-4">
                        <div class="form-group">
                            <label for="Product">Approved by:</label>
                            <input id="SCManagerId" type="hidden" name="SCManagerId">
                            <input id="SCManagerEmail" type="hidden" name="SCManagerEmail">
                            <input id="SCManagerContactNum" type="hidden" name="SCManagerContactNum">
                            <input id="SCManager" class="form-control" type="text" name="SCManager" placeholder="Type name here">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" id="PrintButton">Generate</button>
            </div>
        </div>
    </div>
</div>
