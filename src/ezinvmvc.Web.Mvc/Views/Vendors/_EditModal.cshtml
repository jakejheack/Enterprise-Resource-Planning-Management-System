@using ezinvmvc.Web.Models.Common.Modals
@model ezinvmvc.Web.Models.Vendors.VendorEditModel
@{
    Layout = null;
}
@Html.Partial("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Edit Vendor"))
<div class="modal-body">
    <form name="VendorEditForm" role="form" novalidate class="form-validation">
        <input type="hidden" name="Id" value="@Model.Vendor.Id" />
        <div class="row clearfix">
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <input id="name" type="text" value="@Model.Vendor.Name" name="Name" required maxlength="128" minlength="2" class="validate form-control">
                        <label for="name" class="form-label">Name</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <input id="email" type="email" value="@Model.Vendor.Email" name="Email" required maxlength="128" minlength="2" class="validate form-control">
                        <label for="email" class="form-label">Email</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row clearfix">
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <input id="phone" type="text" value="@Model.Vendor.Phone" name="Phone" required maxlength="32" minlength="2" class="validate form-control">
                        <label for="phone" class="form-label">Phone</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <input id="taxno" type="text" value="@Model.Vendor.TaxNo" name="TaxNo" required maxlength="32" minlength="2" class="validate form-control">
                        <label for="taxno" class="form-label">Tax No.</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row clearfix">
            <div class="col-sm-12">
                <div class="form-group form-float">
                    <div class="form-line">
                        <textarea asp-for="@Model.Vendor.Address" id="address" name="Address" class="form-control"></textarea>
                        <label for="address" class="form-label">Address</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row clearfix">
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <input id="city" type="text" value="@Model.Vendor.City" name="City" class="validate form-control">
                        <label for="city" class="form-label">City</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <select name="Country" id="Country" class="selectpicker form-control" data-live-search="true">
                            @foreach (var country in ViewBag.Countries)
                            {
                                if (country == Model.Vendor.Country)
                                {
                                    <option value="@country" selected>@country</option>
                                }
                                else
                                {
                                    <option value="@country">@country</option>
                                }
                            }
                        </select>
                        <label for="country" class="form-label">Country</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <select name="IsTransporter" id="IsTransporter" class="form-control" tabindex="-1" data-live-search="true">
                        @if (Model.Vendor.IsTransporter == 0)
                        {
                            <option value="0" selected>No</option>
                            <option value="1">Yes</option>
                        }
                        else
                        {
                            <option value="0">No</option>
                            <option value="1" selected>Yes</option>
                        }

                    </select>
                    <label for="IsTransporter">Is Transporter</label>
                </div>
            </div>
        </div>
    </form>
</div>
@Html.Partial("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
<script src="~/view-resources/Views/Vendors/_EditModal.js" asp-append-version="true"></script>
