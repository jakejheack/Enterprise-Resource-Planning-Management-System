@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@{
    ViewBag.CurrentPageName = PageNames.Vendors;
}
@section scripts
    {
    <script src="~/view-resources/Views/Vendors/Index.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Vendors</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="text-right" style="padding-top:10px">
                    @*<div class="btn-group" role="group">
                        <button id="btnGroupDrop1" type="button" class="btn btn-outline-primary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Menu
                        </button>
                        <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">*@
                            @if (IsGranted(PermissionNames.Master_Vendors_Export))
                            {
                                <button id="ExportToExcelButton" class="btn btn-outline-success btn-sm"><i class="fa fa-file-excel-o"></i>&nbsp;Export</button>
                                @*<a id="ExportToExcelButton" class="dropdown-item" href="#"><i class="fa fa-file-excel-o"></i>&nbsp;&nbsp;Export</a>
                                <a id="ExportToPDFButton" class="dropdown-item" href="#"><i class="fa fa-file-pdf-o"></i>&nbsp;&nbsp;PDF</a>*@
                            }
                        @*</div>
                    </div>*@

                    @if (IsGranted(PermissionNames.Master_Vendors_Create))
                    {
                        <button id="CreateButton" data-toggle="modal" data-target="#VendorCreateModal" class="btn btn-outline-primary btn-sm">Create</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        @* Filter *@
                        <div class="row align-items-center m--margin-bottom-10">
                            <div class="col-md-4 col-xl-4">

                            </div>
                            <div class="col-md-4 col-xl-4">

                            </div>
                            <div class="col-md-4 col-xl-4">
                                <div class="input-group">
                                    <input type="text" id="SearchFilter" class="form-control m-input" placeholder="Search..." value="@Model.FilterText">
                                    <span class="input-group-btn">
                                        <button id="SearchButton" class="btn btn-default" type="submit"><i class="fa fa-search" aria-label="@L("Search")"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        @* List *@
                        <div class="row align-items-center">
                            <div class="col-xl-12">
                                <table id="VendorsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th width="20%">Name</th>
                                            <th width="20%">Email</th>
                                            <th width="15%">Phone</th>
                                            <th width="20%">City</th>
                                            <th width="20%">Country</th>
                                            <th width="5%">@L("Actions")</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="col-xl-12" hidden>
                                <table id="VendorsTable2" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th width="20%">Name</th>
                                            <th width="20%">Email</th>
                                            <th width="15%">Phone</th>
                                            <th width="20%">City</th>
                                            <th width="20%">Country</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="VendorCreateModal" tabindex="-1" role="dialog" aria-labelledby="VendorCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span>Create New Vendor</span>
                </h4>
            </div>
            <div class="modal-body">
                <form name="vendorCreateForm" role="form" novalidate class="form-validation">
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="name" type="text" name="Name" required maxlength="128" minlength="2" class="validate form-control">
                                    <label for="name" class="form-label">Name</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="email" type="email" name="Email" required maxlength="128" minlength="2" class="validate form-control">
                                    <label for="email" class="form-label">Email</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="phone" type="text" name="Phone" required maxlength="32" minlength="2" class="validate form-control">
                                    <label for="phone" class="form-label">Phone</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="taxno" type="text" name="TaxNo" required maxlength="32" minlength="2" class="validate form-control">
                                    <label for="taxno" class="form-label">Tax No.</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-12">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <textarea id="address" name="Address" maxlength="328" class="validate form-control"></textarea>
                                    <label for="address" class="form-label">Address</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="city" type="text" name="City" class="validate form-control">
                                    <label for="city" class="form-label">City</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <select name="Country" id="Country" class="selectpicker form-control" data-live-search="true">
                                        @foreach (var country in ViewBag.Countries)
                                        {
                                            <option value="@country">@country</option>
                                        }
                                    </select>
                                    <label for="country" class="form-label">Country</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <select name="IsTransporter" id="IsTransporter" class="form-control" tabindex="-1" data-live-search="true">
                                    <option value="0" selected>No</option>
                                    <option value="1">Yes</option>
                                </select>

                                <label for="IsTransporter">Is Transporter</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">@L("Cancel")</button>
                        <button type="submit" class="btn btn-primary waves-effect">@L("Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="VendorEditModal" tabindex="-1" role="dialog" aria-labelledby="VendorEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>

