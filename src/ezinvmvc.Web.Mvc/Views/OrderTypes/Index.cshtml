@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@*@using ezinvmvc.Web.Models.CV*@

@{

    ViewBag.CurrentPageName = PageNames.OrderType;

}
<style type="text/css">
    .ui-autocomplete {
        z-index: 2147483647;
    }
</style>

@section scripts
    {
    <script src="~/view-resources/Views/OrderTypes/Index.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>OrderType</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="text-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_OrderType_Create))
                    {
                        @*<button id="CreateNewButton" onclick="location.href='@Url.Action("Create", "OrderType")'" target="_blank" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create</button>*@
                        <button id="CreateButton" data-toggle="modal" data-target="#OrderTypeCreateModal" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create OrderType</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">

                        @* List *@
                        <div class="row align-items-center">
                            <div class="col-xl-12">
                                <table id="OrderTypeTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th width="20%">Name</th>
                                            <th width="10%">Currency</th>
                                            <th width="3%">@L("Actions")</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="OrderTypeCreateModal" tabindex="-1" role="dialog" aria-labelledby="EmployeeCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span>Create New OrderType</span>
                </h4>
            </div>
            <div class="modal-body">
                <form name="OrderTypeCreateForm" role="form" novalidate class="form-validation">
                    <div class="row clearfix">
                        <div class="col-sm-8">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="name" class="form-label">Name</label>
                                    <input id="Name" type="text" name="Name" required maxlength="32" minlength="2" class="validate form-control">

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Currency</label>
                                    <select name="CurrencyId" id="CurrencyId" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">PHP</option>
                                        <option value="2">USD</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label>Receivable Account</label>
                                    <input type="hidden" id="ReceivableAccountId" name="ReceivableAccountId" required>
                                    <input type="text" id="ReceivableAccount" name="ReceivableAccount" placeholder="Type Name to search" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Entry Type</label>
                                    <select name="ReceivableAccountEntry" id="ReceivableAccountEntry" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">Debit</option>
                                        <option value="2">Credit</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label>Sales Account</label>
                                    <input type="hidden" id="SalesAccountId" name="SalesAccountId" required>
                                    <input type="text" id="SalesAccount" name="SalesAccount" placeholder="Type Name to search" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Entry Type</label>
                                    <select name="SalesAccountEntry" id="SalesAccountEntry" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">Debit</option>
                                        <option value="2">Credit</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label>Sales Return Account</label>
                                    <input type="hidden" id="SalesReturnAccountId" name="SalesReturnAccountId" required>
                                    <input type="text" id="SalesReturnAccount" name="SalesReturnAccountE" placeholder="Type Name to search" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Entry Type</label>
                                    <select name="SalesReturnAccountEntry" id="SalesReturnAccountEntry" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">Debit</option>
                                        <option value="2">Credit</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label>Sales Discount Account</label>
                                    <input type="hidden" id="SalesDiscountAccountId" name="SalesDiscountAccountId" required>
                                    <input type="text" id="SalesDiscountAccount" name="SalesDiscountAccount" placeholder="Type Name to search" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Entry Type</label>
                                    <select name="SalesDiscountAccountEntry" id="SalesDiscountAccountEntry" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">Debit</option>
                                        <option value="2">Credit</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Tax Account</label>
                                    <input type="hidden" id="TaxAccountId" name="TaxAccountId" required>
                                    <input type="text" id="TaxAccount" name="TaxAccount" placeholder="Type Name to search" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="email-input" class=" form-control-label">Entry Type</label>
                                    <select name="TaxAccountEntry" id="TaxAccountEntry" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                        <option value="1">Debit</option>
                                        <option value="2">Credit</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-dismiss="modal"><i class="fa fa-close" aria-label="@L("Closed")"></i>&nbsp;Closed</button>
                        <button id="submit" class="btn btn-outline-success btn-sm" type="submit"><i class="fa fa-save" aria-label="@L("Save")"></i>&nbsp;Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

