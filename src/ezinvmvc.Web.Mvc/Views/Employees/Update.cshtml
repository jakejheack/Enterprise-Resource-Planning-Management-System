                                                    @foreach (var item in Model.Manager)
                                                    {
                                                        if (item.Id != Model.Employee.Id)
                                                        {
                                                            if (item.Id == Model.Employee.ManagerId)
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.ManagerId)" selected>@item.UserFullName</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.ManagerId)">@item.UserFullName</option>
                                                            }
                                                        }
                                                    }
