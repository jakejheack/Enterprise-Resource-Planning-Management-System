@using ezinvmvc.Web.Startup
@using ezinvmvc.Web.Models.Employees

@model EmployeeCreateModel
@{
    ViewBag.CurrentPageName = PageNames.Employees_Edit;
}
@section scripts
    {
    <script src="~/view-resources/Views/Employees/Update.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Edit Employee</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    <button id="Back" onclick="location.href='@Url.Action("Index", "Employees")'" target="_blank" class="btn btn-outline-success btn-sm"><i class="fa fa-backward"></i>&nbsp; Back</button>
                    <button id="SaveEmployeeButton" class="btn btn-outline-primary btn-sm"><i class="fa fa-save"></i>&nbsp; Update</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="custom-tab">
                            <nav>
                                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                    <a class="nav-item nav-link active" id="custom-nav-home-tab" data-toggle="tab" href="#custom-nav-home" role="tab" aria-controls="custom-nav-home" aria-selected="true">Employees Profile</a>
                                    <a class="nav-item nav-link" id="custom-nav-profile-tab" data-toggle="tab" href="#custom-nav-profile" role="tab" aria-controls="custom-nav-profile" aria-selected="false">Employee Details</a>
                                    <a class="nav-item nav-link" id="custom-nav-contact-tab" data-toggle="tab" href="#custom-nav-contact" role="tab" aria-controls="custom-nav-contact" aria-selected="false">Educational Attainment</a>
                                </div>
                            </nav>
                            <form id="EmployeeForm" name="EmployeeForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">

                                <div class="tab-content pl-3 pt-2" id="nav-tabContent">
                                    <div class="tab-pane fade show active" id="custom-nav-home" role="tabpanel" aria-labelledby="custom-nav-home-tab">
                                        <div class="row">
                                            <div class="col-md-12 col-xl-12"><br /></div>
                                            @*EmployeeCode*@
                                            <input id="Id" class="form-control" type="hidden" name="Id" value="@Model.Employee.Id">
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="EmployeeCode">Employee Code</label>
                                                <input id="EmployeeCode" class="form-control" type="text" name="EmployeeCode" value="@Model.Employee.EmployeeCode">
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Quota">Employee Quota</label>
                                                <input id="Quota" class="form-control" type="text" name="Quota" value="@Model.Employee.Quota">
                                            </div>
                                            <div class="col-md-6 col-xl-6 "></div>
                                            @*FirstName*@
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="FirstName">FirstName</label>
                                                <input id="FirstName" class="form-control" type="text" name="FirstName" value="@Model.Employee.FirstName" required maxlength="128">
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="MiddleName">Middle Name</label>
                                                <input id="MiddleName" class="form-control" type="text" name="MiddleName" value="@Model.Employee.MiddleName">
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="LastName">Last Name</label>
                                                <input id="LastName" class="form-control" type="text" name="LastName" value="@Model.Employee.LastName" required maxlength="128">
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Gender">Gender</label>
                                                <select name="Gender" id="lbGender" class="selectpicker form-control">
                                                    @if (Model.Employee.Gender == "Male")
                                                    {
                                                        <option selected>Male</option>
                                                        <option> Female </option>
                                                    }
                                                    else if (Model.Employee.Gender == "Female")
                                                    {
                                                        <option>Male</option>
                                                        <option selected>Female</option>
                                                    }
                                                    else if (Model.Employee.Gender == "")
                                                    {
                                                        <option></option>
                                                        <option>Male</option>
                                                        <option>Female</option>
                                                    }
                                                    else if (Model.Employee.Gender is null)
                                                    {
                                                        <option></option>
                                                        <option>Male</option>
                                                        <option>Female</option>
                                                    }
                                                </select>
                                            </div>
                                            @*Department*@
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Department">Department</label>
                                                <div class="input-group">
                                                    <select name="DepartmentId" id="DepartmentId" class="selectpicker form-control" tabindex="-1" data-live-search="true">

                                                        @foreach (var item in Model.Departments)
                                                        {
                                                            if (item.Id == Model.Employee.DepartmentId)
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.DepartmentId)" selected>@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.DepartmentId)">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span class="input-group-btn">
                                                        <button id="CreateDepartmentButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#DepartmentCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>
                                                </div>

                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Division">Division</label>
                                                @*<input id="DivisionId" class="form-control" type="text" name="DivisionId" value="@Model.Employee.DivisionId">*@
                                                <div class="input-group">
                                                    <select name="DivisionId" id="DivisionId" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                        @foreach (var item in Model.DivEmployee)
                                                        {
                                                            if (item.Id == Model.Employee.DivisionId)
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.DivisionId)" selected>@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.DivisionId)">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span class="input-group-btn">
                                                        <button id="CreateDivisionButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#DivisionCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Position">Position</label>
                                                @*<input id="PositionId" class="form-control" type="text" name="PositionId" value="@Model.Employee.PositionId">*@
                                                <div class="input-group">
                                                    <select name="PositionId" id="PositionId" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                        @foreach (var item in Model.Positions)
                                                        {
                                                            if (item.Id == Model.Employee.PositionId)
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.PositionId)" selected>@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.PositionId)">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span class="input-group-btn">
                                                        <button id="CreatePositionButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#PositionCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Sector">Company</label>
                                                @*<input id="SectorsId" class="form-control" type="text" name="SectorsId" value="@Model.Employee.SectorsId">*@
                                                <div class="input-group">
                                                    <select name="SectorsId" id="SectorsId" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                        @foreach (var item in Model.Sertors)
                                                        {
                                                            if (item.Id == Model.Employee.SectorsId)
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.SectorsId)" selected>@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id" name="@Html.NameFor(c => c.Employee.SectorsId)">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                    <span class="input-group-btn">
                                                        <button id="CreateSectorButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#SectorCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>
                                                </div>
                                            </div>
                                            @*Details*@
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="HireDate">Hire Date</label>
                                                @{
                                                    string sDateHire = Model.Employee.HireDate != null ? Model.Employee.HireDate.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="HireDate" name="HireDate" class="input-md form-control-md form-control date-picker" value="@sDateHire">
                                                @*<input id="HireDate" class="form-control date-picker" type="date" name="HireDate" value="@Model.Employee.HireDate" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="StartDate">Rehire Date</label>
                                                @{
                                                    string sStartDate = Model.Employee.StartDate != null ? Model.Employee.StartDate.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="StartDate" name="StartDate" class="input-md form-control-md form-control date-picker" value="@sStartDate">
                                                @*<input id="StartDate" class="form-control date-picker" type="date" name="StartDate" value="@Model.Employee.StartDate" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3" hidden>
                                                <label for="EndDate">End Date</label>
                                                @{
                                                    string sEndDate = Model.Employee.EndDate != null ? Model.Employee.EndDate.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="EndDate" name="EndDate" class="input-md form-control-md form-control date-picker" value="@sEndDate">
                                                @*<input id="EndDate" class="form-control date-picker" type="date" name="EndDate" value="@sEndDate">*@
                                            </div>

                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Emptype">Employee Type</label>
                                                <div class="input-group">
                                                    <select name="EmptypeId" id="EmptypeId" class="selectpicker form-control">
                                                        @if (Model.Employee.EmptypeId == 0)
                                                        {
                                                            <option value="0" selected>Nothing Selected</option>
                                                            <option value="1">Regular</option>
                                                            <option value="2">Probationary</option>
                                                            <option value="3">Project Base</option>
                                                        }
                                                        else if (Model.Employee.EmptypeId == 1)
                                                        {

                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1" selected>Regular</option>
                                                            <option value="2">Probationary</option>
                                                            <option value="3">Project Base</option>
                                                        }
                                                        else if (Model.Employee.EmptypeId == 2)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1">Regular</option>
                                                            <option value="2" selected>Probationary</option>
                                                            <option value="3">Project Base</option>
                                                        }
                                                        else if (Model.Employee.EmptypeId == 3)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1">Regular</option>
                                                            <option value="2">Probationary</option>
                                                            <option value="3" selected>Project Base</option>
                                                        }
                                                    </select>
                                                    @*<span class="input-group-btn">
                                                        <button id="CreateEmptypeId" type="button" class="btn btn-default" data-toggle="modal" data-target="#EmptypeIdCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>*@
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Emptype">Salary Type</label>
                                                <div class="input-group">
                                                    <select name="EmpSalarytypeId" id="EmpSalarytypeId" class="selectpicker form-control">
                                                        @if (Model.Employee.EmpSalarytypeId == 0)
                                                        {
                                                            <option value="0" selected>Nothing Selected</option>
                                                            <option value="1">Cash</option>
                                                            <option value="2">Card</option>
                                                            <option value="3">Gcash</option>
                                                            <option value="4">Cheque</option>
                                                        }
                                                        else if (Model.Employee.EmpSalarytypeId == 1)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1" selected>Cash</option>
                                                            <option value="2">Card</option>
                                                            <option value="3">Gcash</option>
                                                            <option value="4">Cheque</option>
                                                        }
                                                        else if (Model.Employee.EmpSalarytypeId == 2)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1">Cash</option>
                                                            <option value="2" selected>Card</option>
                                                            <option value="3">Gcash</option>
                                                            <option value="4">Cheque</option>
                                                        }
                                                        else if (Model.Employee.EmpSalarytypeId == 3)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1">Cash</option>
                                                            <option value="2">Card</option>
                                                            <option value="3" selected>Gcash</option>
                                                            <option value="4">Cheque</option>
                                                        }
                                                        else if (Model.Employee.EmpSalarytypeId == 4)
                                                        {
                                                            <option value="0">Nothing Selected</option>
                                                            <option value="1">Cash</option>
                                                            <option value="2">Card</option>
                                                            <option value="3">Gcash</option>
                                                            <option value="4" selected>Cheque</option>
                                                        }
                                                    </select>
                                                    <span class="input-group-btn">
                                                        <button id="CreateEmpSalarytypeId" type="button" class="btn btn-default" data-toggle="modal" data-target="#EmpSalarytypeIdCreateModal">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-xl-3 " hidden>
                                                <label for="ReleasedDate">Released Date</label>
                                                @{
                                                    string sReleasedDate = Model.Employee.ReleasedDate != null ? Model.Employee.EndDate.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="ReleasedDate" name="ReleasedDate" class="input-md form-control-md form-control date-picker" value="@sReleasedDate">
                                                @*<input id="ReleasedDate" class="form-control date-picker" type="date" name="ReleasedDate" value="@Model.Employee.ReleasedDate" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="DateRegular">Regular Date</label>
                                                @{
                                                    string sDateRegular = Model.Employee.DateRegular != null ? Model.Employee.DateRegular.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="DateRegular" name="DateRegular" class="input-md form-control-md form-control date-picker" value="@sDateRegular">
                                                @*<input id="DateRegular" class="form-control date-picker" type="date" name="DateRegular" value="@Model.Employee.DateRegular" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="DateResigned">Resigned Date</label>
                                                @{
                                                    string sDateResigned = Model.Employee.DateResigned != null ? Model.Employee.DateResigned.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="DateResigned" name="DateResigned" class="input-md form-control-md form-control date-picker" value="@sDateResigned">
                                                @*<input id="DateResigned" class="form-control date-picker" type="date" name="DateResigned" value="@Model.Employee.DateResigned" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="DateTerminated">Terminated Date</label>
                                                @{
                                                    string sDateTerminated = Model.Employee.DateTerminated != null ? Model.Employee.DateTerminated.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="DateTerminated" name="DateTerminated" class="input-md form-control-md form-control date-picker" value="@sDateTerminated">
                                                @*<input id="DateTerminated" class="form-control date-picker" type="date" name="DateTerminated" value="@Model.Employee.DateTerminated" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="Status">Status</label>
                                                <select name="StatusId" id="lbStatus" class="selectpicker form-control">
                                                    @if (Model.Employee.StatusId == 1)
                                                    {
                                                        <option value="1" selected>Hired</option>
                                                        <option value="2">Resigned</option>
                                                        <option value="3">Terminated</option>
                                                        <option value="4">Rehired</option>
                                                    }
                                                    else if (Model.Employee.StatusId == 2)
                                                    {
                                                        <option value="1">Hired</option>
                                                        <option value="2" selected>Resigned</option>
                                                        <option value="4">Rehired</option>
                                                    }
                                                    else if (Model.Employee.StatusId == 3)
                                                    {
                                                        <option value="1">Hired</option>
                                                        <option value="2">Resigned</option>
                                                        <option value="3" selected>Terminated</option>
                                                        <option value="4">Rehired</option>
                                                    }
                                                    else if (Model.Employee.StatusId == 4)
                                                    {
                                                        <option value="1">Hired</option>
                                                        <option value="2">Resigned</option>
                                                        <option value="3">Terminated</option>
                                                        <option value="4" selected>Rehired</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="1" selected>Hired</option>
                                                        <option value="2">Resigned</option>
                                                        <option value="3">Terminated</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="BirthDate">Birth Date</label>
                                                @{
                                                    string sBirthDate = Model.Employee.BirthDate != null ? Model.Employee.BirthDate.Value.ToString("MM/dd/yyyy") : "";
                                                }
                                                <input type="text" id="BirthDate" name="BirthDate" class="input-md form-control-md form-control date-picker" value="@sBirthDate">
                                                @*<input id="BirthDate" class="form-control date-picker" type="date" name="BirthDate" value="@Model.Employee.BirthDate" placeholder="01/01/1999">*@
                                            </div>
                                            <div class="col-md-3 col-xl-3 ">
                                                <label for="CivilStatus">Civil Status</label>
                                                <select name="CivilStatus" id="lbCivilStatus" class="selectpicker form-control">

                                                    @if (@Model.Employee.CivilStatus == "S")
                                                    {
                                                        <option selected>S</option>
                                                        <option>S1</option>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "S1")
                                                    {
                                                        <option>S</option>
                                                        <options elected>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "S2")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option selected>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "S3")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option selected>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "S4")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option selected>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "ME1")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option selected>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "ME2")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option selected>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "ME3")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option selected>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "ME4")
                                                    {
                                                        <option>S</option>
                                                        <options>S1</options>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option selected>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus is null)
                                                    {
                                                        <option></option>
                                                        <option>S</option>
                                                        <option>S1</option>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
                                                        <option>ME4</option>
                                                    }
                                                    else if (@Model.Employee.CivilStatus == "")
                                                    {
                                                        <option></option>
                                                        <option>S</option>
                                                        <option>S1</option>
                                                        <option>S2</option>
                                                        <option>S3</option>
                                                        <option>S4</option>
                                                        <option>ME1</option>
                                                        <option>ME2</option>
                                                        <option>ME3</option>
