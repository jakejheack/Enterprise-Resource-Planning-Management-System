                                                <select name="IsAgent" id="lbAgent" class="selectpicker form-control">

                                                    @if (Model.Employee.IsAgent == false)
                                                    {
                                                        <option></option>
                                                        <option value="true">Yes</option>
                                                        <option value="false" selected>No</option>
                                                    }
                                                    else if (Model.Employee.IsAgent == true)
                                                    {
                                                        <option></option>
                                                        <option value="true" selected>Yes</option>
