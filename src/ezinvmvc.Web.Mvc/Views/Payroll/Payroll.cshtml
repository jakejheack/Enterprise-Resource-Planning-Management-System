                                        <option value="1">Basic</option>
                                        <option value="2">Gross</option>
                                        <option value="3">Fix</option>
                                    </select>
                                    <select id="PhilHealthCutOff" name="PhilHealthCutOff" class="form-control selectpicker secondary" data-live-search="true">
                                        <option value="" selected>-Cut Off-</option>
                                        <option value="1">1st</option>
                                        <option value="2">2nd</option>
                                        <option value="3">Both</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PhilHealthEC" name="PhilHealthEC" type="text" class="form-control" placeholder="EC 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PhilHealthER" name="PhilHealthER" type="text" class="form-control" placeholder="ER 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PhilHealthECC" name="PhilHealthECC" type="text" class="form-control" placeholder="TOTAL" maxlength="128">
                            </div>

                            <div class="col-md-6 col-xl-6">
                                <input type="checkbox" class="form-check-input" id="WTaxcheck" style="height: 30px;">
                                <div class="input-group mb-12">
                                    <div class="input-group-prepend">
                                        <label for="EmployeeName" class="btn btn-outline-primary" readonly style="width: 120px;text-align: LEFT;"><i class="fa fa-th-large"></i> W/Tax</label>
                                    </div>
                                    <select id="WTaxType" name="WTaxType" class="form-control selectpicker primary" data-live-search="true">
                                        <option value="" selected>-Type-</option>
                                        <option value="1">Basic</option>
                                        <option value="2">Gross</option>
                                        <option value="3">Fix</option>
                                    </select>
                                    <select id="WTaxCutOff" name="WTaxCutOff" class="form-control selectpicker secondary" data-live-search="true">
                                        <option value="" selected>-Cut Off-</option>
                                        <option value="1">1st</option>
                                        <option value="2">2nd</option>
                                        <option value="3">Both</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <button id="btnCompute" type="button" class="btn btn-outline-success btn-lg pull-right" style="width:100%"><i class="fa fa-calculator"></i>&nbsp;Compute</button>
                                <input id="WTaxER" name="WTaxER" type="text" class="form-control" placeholder="0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="WTaxEC" name="WTaxEC" type="text" class="form-control" placeholder="0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="WTaxECC" name="WTaxECC" type="text" class="form-control" placeholder="TOTAL" maxlength="128">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="AttRecord" tabindex="-1" role="dialog" aria-labelledby="AttRecordLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Attendance</span>
                </h6>
            </div>
            <div class="modal-body">
                <div style="width: 100%; overflow-y: scroll;">
                    <table id="AttRecTable" class="table table-striped table-hover dt-responsive nowrap">
                        <thead>
                            <tr>
                                <th>AttId</th>
                                <th>Date</th>
                                <th width="20%">Days</th>
                                <th width="20%">Holidays</th>
                                <th width="20%">TimeIn</th>
                                <th width="20%">BreakOut</th>@*5*@
                                <th width="20%">BreakIn</th>
                                <th width="20%">TimeOut</th>
                                <th width="20%"></th>@*Status18*@
                                <th width="20%"></th>@*AMIn*@
                                <th width="20%"></th>@*BreakOut10*@
                                <th width="20%"></th>@*BreakIn*@
                                <th width="20%"></th>@*pmOut*@
                                <th width="20%"></th>@*amLateIn*@
                                <th width="20%"></th>@*amLAteEndIn*@
                                <th width="20%">CountLates</th>@*CountLates*@
                                <th width="20%">Lates</th>@*Lates16*@
                                <th width="20%">UnderTime</th>@*Tardiness17*@
                                <th width="20%">NightDiff</th>@*NightDiff18*@
                                <th width="20%"></th>@*Daily19*@
                                <th width="20%"></th>@*TotalDaily20*@
                                <th width="20%"></th>@*Status221*@
                                <th width="20%"></th>@*Status322*@
                                <th width="20%"></th>@*Description123*@
                                <th width="20%"></th>@*Legal24*@
                                <th width="20%"></th>@*HolPercent25*@
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button name="ExportToExcelButton" id="ExportToExcelButton" type="button" class="btn btn-outline-primary"><i class="fa fa-file-excel-o"></i>&nbsp;Export</button>

                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>

