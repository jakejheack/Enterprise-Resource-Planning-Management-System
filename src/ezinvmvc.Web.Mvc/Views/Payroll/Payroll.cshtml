                                <input type="checkbox" class="form-check-input" id="Pagibigcheck" style="height: 30px;">
                                <div class="input-group mb-12">
                                    <div class="input-group-prepend">
                                        <label for="EmployeeName" class="btn btn-outline-primary" readonly style="width: 120px;text-align: LEFT;"><i class="fa fa-th-large"></i> Pag-ibig</label>
                                    </div>
                                    <select id="PagibigType" name="PagibigType" class="form-control selectpicker primary" data-live-search="true">
                                        <option value="" selected>-Type-</option>
                                        <option value="1">Basic</option>
                                        <option value="2">Gross</option>
                                        <option value="3">Fix</option>
                                    </select>
                                    <select id="PagibigCutOff" name="PagibigCutOff" class="form-control selectpicker secondary" data-live-search="true">
                                        <option value="" selected>-Cut Off-</option>
                                        <option value="1">1st</option>
                                        <option value="2">2nd</option>
                                        <option value="3">Both</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PagibigEC" name="PagibigEC" type="text" class="form-control" placeholder="EC 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PagibigER" name="PagibigER" type="text" class="form-control" placeholder="ER 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="PagibigECC" name="PagibigECC" type="text" class="form-control" placeholder="TOTAL" maxlength="128">
                            </div>
                            <div class="col-md-6 col-xl-6">
                                <input type="checkbox" class="form-check-input" id="PhilHealthcheck" style="height: 30px;">
                                <div class="input-group mb-12">
                                    <div class="input-group-prepend">
                                        <label for="EmployeeName" class="btn btn-outline-primary" readonly style="width: 120px;text-align: LEFT;"><i class="fa fa-th-large"></i> Phil-Health</label>
                                    </div>
                                    <select id="PhilHealthType" name="PhilHealthType" class="form-control selectpicker primary" data-live-search="true">
