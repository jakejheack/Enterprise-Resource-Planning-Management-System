        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Contribution</span>
                </h6>
                <div class="modal-body" style="height:400px">
                    <form name="frmcontribution" role="form" novalidate class="form-validation">
                        <div class="row">
                            <div class="col-md-6 col-xl-6">
                                <label for="EmployeeName" class="col-md-12 col-xl-12 flat-color-4">Description</label>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <label for="EmployeeName" class="col-md-12 col-xl-12 flat-color-4">EE</label>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <label for="EmployeeName" class="col-md-12 col-xl-12 flat-color-4">ER</label>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <label for="EmployeeName" class="col-md-12 col-xl-12 flat-color-4"></label>
                            </div>

                            <div class="col-md-6 col-xl-6">
                                <input type="checkbox" class="form-check-input" id="ssscheck" style="height: 30px;">
                                <div class="input-group mb-12">
                                    <div class="input-group-prepend">
                                        <label for="EmployeeName" class="btn btn-outline-primary" readonly style="width: 120px;text-align: LEFT;"><i class="fa fa-th-large"></i> SSS</label>
                                    </div>
                                    <select id="SSSType" name="SSSType" class="form-control selectpicker primary" data-live-search="true">
                                        <option value="" selected>-Type-</option>
                                        <option value="1">Basic</option>
                                        <option value="2">Gross</option>
                                        <option value="3">Fix</option>
                                    </select>
                                    <select id="SSSCutOff" name="SSSCutOff" class="form-control selectpicker secondary" data-live-search="true">
                                        <option value="" selected>-Cut Off-</option>
                                        <option value="1">1st</option>
                                        <option value="2">2nd</option>
                                        <option value="3">Both</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="SSSEE" name="SSSEE" type="text" class="form-control" placeholder="ER 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="SSSER" name="SSSER" type="text" class="form-control" placeholder="EC 0.00" maxlength="128">
                            </div>
                            <div class="col-md-2 col-xl-2">
                                <input id="SSSEC" name="SSSEC" type="text" class="form-control" placeholder="ECC 0.00" maxlength="128">
                            </div>

