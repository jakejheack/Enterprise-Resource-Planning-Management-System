                                                    <th width="15%">Total</th>@*5 Total*@
                                                    <th width="5%"></th>@*6 Total*@
                                                    <th></th>@*7 ProductId*@
                                                    <th></th>@*8 Description*@
                                                    <th></th>@*9 OrderQty*@
                                                    <th></th>@*10 UnitId*@
                                                    <th></th>@*11 Disc1*@
                                                    <th></th>@*12 DiscType1*@
                                                    <th></th>@*13 Disc2*@
                                                    <th></th>@*14 DiscType2*@
                                                    <th></th>@*15 Disc3*@
                                                    <th></th>@*16 DiscType3*@
                                                    <th></th>@*17 Expense Account*@
