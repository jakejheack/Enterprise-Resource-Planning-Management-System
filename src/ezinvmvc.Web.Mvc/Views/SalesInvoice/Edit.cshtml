@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    ViewBag.CurrentPageName = PageNames.Sales_Invoice_Edit;
}
@section scripts
    {
    <script src="~/view-resources/Views/SalesInvoice/Edit.js" asp-append-version="true"></script>
    <script src="~/js/toWords.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>
                            Sales Invoice
                            <span id="StatusBadge"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_Sales_Invoice_Create))
                    {
                        <button id="SaveButton" class="btn btn-outline-primary btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Update</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Invoice_Edit))
                    {
                        <button id="SubmitButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Submit</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Invoice_Edit))
                    {
                        <button id="CancelButton" class="btn btn-outline-danger btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Void</button>
                    }
                    <div id="PrintMenuButton" class="btn-group" role="group">
                        <button id="btnGroupDrop" type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-print"></i>
                            Print
                        </button>
                        <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
                            <a id="PrintButton" class="dropdown-item" href="#">&nbsp;&nbsp;Invoice</a>
                            <a id="PrintSOAButton" class="dropdown-item" href="#">&nbsp;&nbsp;SOA</a>
                        </div>
                    </div>
                    <div id="PrintMenuButton2" class="btn-group" role="group">
                        <button id="btnGroupDrop2" type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-print"></i>
                            Print as Lot
                        </button>
                        <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
                            <a id="PrintButton2" class="dropdown-item" href="#">&nbsp;&nbsp;Invoice</a>
                            <a id="PrintSOAButton2" class="dropdown-item" href="#">&nbsp;&nbsp;SOA</a>
                        </div>
                    </div>
                    @*<button id="PrintButton" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i>&nbsp; Print</button>*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <form id="SalesOrderForm" name="SalesOrderForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
            <div class="row clearfix">
                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row" hidden>
                                <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="Product">Series</label>
                                        <input id="Prefix" name="Prefix" class="form-control" type="hidden" readonly>
                                        <input id="SeriesTypeId" type="hidden" name="SeriesTypeId">
                                        <input id="Code" name="Code" class="form-control font-weight-bold" type="text" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Date</label>
                                        <div class="input-group date" data-provide="datepicker">
                                            <input type="text" id="TransactionTime" name="TransactionTime" class="form-control date-picker" requiredreadonly>
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddOrderType">Order Type</label>
                                        <select name="OrderTypeId" id="OrderTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" readonly required></select>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Sales Order No.</label>
                                        <input id="Id" type="hidden" value="@ViewBag.Id" name="Id">
                                        <input id="SalesAccountId" name="SalesAccountId" type="hidden" value="0">
                                        <input id="BankAccountId" name="BankAccountId" type="hidden" value="0">
                                        <input id="TaxAccountId" name="TaxAccountId" type="hidden" value="0">
                                        <input id="ReceivableAccountId" name="ReceivableAccountId" type="hidden" value="0">
                                        @*MARC 11162022 Accounting*@
                                        <input id="DiscountAccountId" name="DiscountAccountId" type="hidden" value="0">
                                        <input id="ReturnAccountId" name="ReturnAccountId" type="hidden" value="0">

                                        <input id="SalesAccountEntry" name="SalesAccountEntry" type="hidden" value="0">
                                        <input id="ReceivableAccountEntry" name="ReceivableAccountEntry" type="hidden" value="0">
                                        <input id="DiscountAccountEntry" name="DiscountAccountEntry" type="hidden" value="0">
                                        <input id="ReturnAccountEntry" name="ReturnAccountEntry" type="hidden" value="0">
                                        <input id="TaxAccountEntry" name="TaxAccountEntry" type="hidden" value="0">
                                        @*Accounting*@
                                        <input id="SalesOrderId" type="hidden" value="0" name="SalesOrderId">
                                        <input id="SalesOrderCode" type="text" name="SalesOrderCode" class="form-control" placeholder="Type here" required readonly>
                                    </div>

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">

                                    <div class="form-group">
                                        <label for="txtClient">Client Name</label>
                                        <input id="ClientId" type="hidden" name="ClientId" required>
                                        <input id="ClientName" class="form-control" type="text" name="Client" placeholder="Type here" readonly required>
                                    </div>

                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Client's Purchase Order</label>
                                        <input type="text" id="ClientOrderNo" name="ClientOrderNo" class="form-control" readonly required>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">TIN</label>
                                        <input id="TaxNo" dirname="TaxNo" class="form-control" type="text" name="TaxNo" required>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Business Style</label>
                                        <input type="text" id="BusinessStyle" name="BusinessStyle" class="form-control" required>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Account Executive</label>
                                        <input id="SalesAgentId" type="hidden" name="SalesAgentId" required>
                                        <input id="SalesAgent" class="form-control" type="text" name="SalesAgent" placeholder="Type here" readonly required>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddPriceType">Price Type</label>
                                        <select name="PricingTypeId" id="PricingTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" readonly required></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-md-12 col-xl-12">
                    <div class="card" id="accordion">
                        <div class="card-header">
                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
