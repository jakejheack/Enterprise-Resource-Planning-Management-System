                                                        <th></th>@*18 Inventory Account*@
                                                        <th></th>@*19 Income Account*@
                                                        <th></th>@*20 Id*@
                                                        <th>20</th>@*20 Id*@
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-xl-12" id="Editaccordion">
