@using ezinvmvc.Web.Models.Common.Modals
@model ezinvmvc.Web.Models.Documents.DocumentModel
@{
    Layout = null;
}
<script src="~/view-resources/Views/Documents/" asp-append-version="true"></script>
@Html.Partial("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Documents"))
<div class="modal-body">
    <form name="DocumentForm" role="form" novalidate class="form-validation">
        <div class="row clearfix" style="margin-top:10px;">
            <div class="col-sm-6">
                <div class="form-group form-float">
                    <div class="form-line">
                        <label class="form-label">For</label>
                        <input type="hidden" id="ReferenceId" name="ReferenceId" value="@Model.Document.ReferenceId" />
                        <input type="hidden" id="Reference" name="Reference" value="@Model.Document.Reference" readonly />
                        <input type="text" id="ReferenceName" name="ReferenceName" class="form-control" value="@Model.Document.ReferenceName" readonly />
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                &nbsp;
            </div>
        </div>
        <div class="row clearfix" style="margin-top:10px;">
            <div class="col-sm-3">
                <div class="form-group">
                    <label for="Product">Document Upload</label>
                    <div class="col-sm-12">
                        <div class="sui-upload">
                            <input type="file" id="fileinput">
                        </div>
                        <p id="demo"></p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label for="Lead">Notes</label>
                    <textarea id="Notes" name="Description" maxlength="328" class="validate form-control"></textarea>
                </div>
            </div>
            <div class="col-sm-3">
                <button id="UploadButton" class="btn btn-outline-primary btn-sm"><i class="fa fa-save"></i>&nbsp; Upload</button>
            </div>
        </div>
        <div class="row clearfix" style="margin-top:10px;">
            <div class="col-sm-12">
                <table id="DocumentsTable" role="presentation" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                    <thead>
                        <tr>
                            <th></th>
                            <th>File</th>
                            <th>Type</th>
                            <th style="width:250px">Remarks</th>
                            <th>By</th>
                            <th>Date</th>
                            <th style="width:1%">Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </form>
</div>
@*@Html.Partial("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")*@

