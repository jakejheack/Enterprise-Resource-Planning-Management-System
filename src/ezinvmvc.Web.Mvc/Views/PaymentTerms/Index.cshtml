@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    //ViewData["Title"] = "RFQ";

    ViewBag.CurrentPageName = PageNames.PaymentTerm;

}
@section scripts
    {
    <script src="~/view-resources/Views/PaymentTerms/Index.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Payment Terms</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="text-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_PaymentTerm_Create))
                    {
                    <button id="CreateButton" data-toggle="modal" data-target="#PaymentTermCreateModal" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create Payment Term</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        @* Filter *@
                        @*<div class="row align-items-center m--margin-bottom-10">
                                <input type="text" id="h1" value="@Model.EmpId" hidden>
                                <input type="text" id="hassignid" hidden>
                                <div class="col-md-3 col-xl-3">
                                    <div class="form-group">
                                        <input type="text" id="DateFrom" name="DateFrom" class="form-control input-sm form-control-sm date-picker" placeholder="mm/dd/yyyy" required>
                                    </div>
                                </div>

                                <div class="col-md-3 col-xl-3">
                                    <div class="form-group">
                                        <input type="text" id="DateTo" name="DateTo" class="form-control input-sm form-control-sm date-picker" placeholder="mm/dd/yyyy" required>
                                    </div>
                                </div>
                                <div class="col-md-3 col-xl-3" hidden>
                                    <div class="form-group">
                                        <select id="StatusTypes" class="selectpicker form-control input-sm form-control-sm" multiple data-live-search="true">
                                            <option value="1">Draft</option>
                                            <option value="2">Submitted</option>
                                            <option value="3">For Revision</option>
                                            <option value="4">Closed</option>
                                            <option value="5">Revised</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-6">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <input type="text" id="SearchFilter" class="form-control m-input input-sm form-control-sm" placeholder="Type Code and Client to search">
                                            <span class="input-group-btn">
                                                <button id="SearchButton" class="btn btn-default btn-sm" type="submit"><i class="fa fa-search" aria-label="@L("Search")"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>*@

                        @* List *@
                        <div class="row align-items-center">
                            <div class="col-xl-12">
                                <table id="PaymentTermTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th width="10%">Name</th>
                                            <th width="20%">Days</th>
                                            <th width="10%">Is Advance</th>
                                            <th width="3%">@L("Actions")</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="PaymentTermCreateModal" tabindex="-1" role="dialog" aria-labelledby="PaymentTermCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span>Create Payment Term</span>
                </h4>
            </div>
            <div class="modal-body">
                <form name="PaymentTermCreateForm" role="form" novalidate class="form-validation">
                    <div class="row clearfix">
                        <div class="col-sm-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="Name" class="form-label">Name</label>
                                    <input id="Name" type="text" name="Name" required class="validate form-control">

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="Days" class="form-label">Days</label>
                                    <input id="Days" type="number" name="NoOfDays" required class="validate form-control">

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-4">
                            <div class="checkbox">
                                <label for="IsAdvance">Is Advance</label>
                                <input id="IsDeleted" type="text" name="IsDeleted" value="false" class="validate form-control" hidden>

                                <input type="checkbox" name="IsAdvance" value="true" id="IsAdvance" class="filled-in" checked />
                            </div>
                        </div>
                        <div class="col-sm-8">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-dismiss="modal"><i class="fa fa-close" aria-label="@L("Closed")"></i>&nbsp;Closed</button>
                        <button id="submit" class="btn btn-outline-success btn-sm" type="submit"><i class="fa fa-save" aria-label="@L("Save")"></i>&nbsp;Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="PaymentTermEditModal" tabindex="-1" role="dialog" aria-labelledby="PaymentTermEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">

                    <span>Edit Payment Term</span>
                </h4>
            </div>
            <div class="modal-body">
                <form name="PaymentTermEditForm" role="form" novalidate class="form-validation">
                    <div class="row clearfix">
                        <div class="col-sm-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="Id" type="text" name="Id" required hidden>
                                    <label for="Ename" class="form-label">Name</label>
                                    <input id="Ename" type="text" name="Ename" required class="validate form-control">

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <label for="abbr" class="form-label">Days</label>
                                    <input id="Edays" type="number" name="Edays" required class="validate form-control">

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-4">
                            <div class="checkbox">
                                <label for="Eadv">Is Advance</label>
                                <input type="checkbox" name="Eadv" value="true" id="Eadv" class="filled-in" checked />
                            </div>
                        </div>
                        <div class="col-sm-8">
                        </div>
                    </div>



                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-dismiss="modal"><i class="fa fa-close" aria-label="@L("Closed")"></i>&nbsp;Closed</button>
                        <button id="update" class="btn btn-outline-success btn-sm" type="submit"><i class="fa fa-save" aria-label="@L("Save")"></i>&nbsp;Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



