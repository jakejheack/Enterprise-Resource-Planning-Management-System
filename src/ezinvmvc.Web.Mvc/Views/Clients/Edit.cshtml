@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Clients
@using ezinvmvc.App.Clients

@model ClientEditModel
@{
    ViewBag.CurrentPageName = PageNames.Clients_Edit;
}
@section scripts
    {
    <script src="~/view-resources/Views/Clients/Edit.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <input type="text" id="h1" value="@Model.EmpId" hidden>
                    <div class="page-title">
                        <h1>
                            Edit Client
                            <span id="StatusBadge">@Model.Client.Status</span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Master_Clients_Edit))
                    {
                        <button id="SaveClientButton" class="btn btn-outline-primary btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Update</button>
                    }
                    @if (IsGranted(PermissionNames.Master_Clients_Approve))
                    {
                        <button id="ApproveButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Approve</button>
                        <button id="DisapproveButton" class="btn btn-outline-danger btn-sm" hidden><i class="fa fa-edit"></i>&nbsp; Disapprove</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body card-block">
                        <form id="ClientForm" name="ClientForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
                            <div class="row">
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">Ref. No.</label>
                                        <input type="hidden" id="Id" name="Id" value="@Model.Client.Id">
                                        <input type="hidden" id="CompanyId" name="CompanyId" value="@Model.Client.CompanyId" />
                                        <input type="hidden" id="Prefix" name="Prefix" value="@Model.Client.Prefix" />
                                        <input type="hidden" id="SeriesTypeId" name="SeriesTypeId" value="@Model.Client.SeriesTypeId" />
                                        <input type="hidden" id="Code" name="Code" value="@Model.Client.Code" />
                                        <input type="hidden" id="StatusId" name="StatusId" value="@Model.Client.StatusId" />
                                        <input id="iCode" class="form-control" type="text" name="iCode" value="@Model.Client.Code" readonly maxlength="128">
                                    </div>
                                </div>
                                <div class="col-md-8 col-xl-8 ">
                                    <div class="form-group">
                                        <label for="Client">Name</label>
                                        <input id="Name" class="validate form-control" type="text" name="Name" value="@Model.Client.Name" required maxlength="128">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-xl-4 " hidden>
                                    <div class="form-group">
                                        <label for="Client">Type</label>
                                        <select id="Type" name="Type" class="selectpicker form-control">
                                            @if (Model.Client.Type.ToUpper() == "Corporate".ToUpper())
                                            {
                                                <option selected>Corporate</option>
                                                <option>Individual</option>
                                            }
                                            else if (Model.Client.Type.ToUpper() == "Individual".ToUpper())
                                            {
                                                <option>Corporate</option>
                                                <option selected>Individual</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 col-xl-3 " hidden>
                                    <div class="form-group">
                                        <label for="Client">Reseller</label>
                                        <select id="IsReseller" name="IsReseller" class="selectpicker form-control">
                                            @if (Model.Client.IsReseller)
                                            {
                                                <option value=false>No</option>
                                                <option value=true selected>Yes</option>
                                            }
                                            else
                                            {
                                                <option value=false selected>No</option>
                                                <option value=true>Yes</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">TIN</label>
                                        <input id="TaxNo" class="validate form-control" type="text" name="TaxNo" value="@Model.Client.TaxNo" maxlength="31">
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">VAT Type</label>
                                        <input type="hidden" id="hVATTypeId" name="hVATTypeId" value="@Model.Client.VATTypeId" />
                                        <select id="VATTypeId" name="VATTypeId" class="selectpicker form-control"></select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <div class="form-group">
                                        <label for="Client">Email</label>
                                        <input type="email" id="Email" name="Email" class="validate form-control" value="@Model.Client.Email">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-xl-4">
                                    <label for="Client">Tel. No</label>
                                    <input id="TelNo" class="validate form-control" type="text" name="TelNo" value="@Model.Client.TelNo">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="Client">Fax No.</label>
                                    <input id="FaxNo" class="validate form-control" type="text" name="FaxNo" value="@Model.Client.FaxNo">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="Client">Mobile No.</label>
                                    <input id="MobileNo" class="validate form-control" type="text" name="MobileNo" value="@Model.Client.MobileNo">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-xl-6">
                                    <label for="Client">Market Segmentation</label>
                                    <select id="IndustryId" name="IndustryId" class="selectpicker form-control" required>
                                        <option value="0">-- Select --</option>
                                        @foreach (var item in Model.Industries)
                                        {
                                            if (item.Id == Model.Client.IndustryId)
                                            {
                                                <option value="@item.Id" selected>@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        }
                                    </select>
                                    <span id="errInds" class="error" style="display:none">This field is required.</span>
                                </div>
                                <div class="col-md-6 col-xl-6">
                                    <label for="Client">Business Style</label>
                                    <input id="BusinessStyle" class="validate form-control" type="text" name="BusinessStyle" value="@Model.Client.BusinessStyle">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">Country</label>
                                        <div class="input-group">
                                            <select name="CountryId" id="lbCountries" class="selectpicker form-control" tabindex="-1" data-live-search="true" required>
                                                <option value=0>-- Select --</option>
                                                @foreach (var item in Model.Countries)
                                                {
                                                    if (Model.Client.CountryId == item.Id)
                                                    {
                                                        <option value="@item.Id" selected>@item.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Id">@item.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span class="input-group-btn">
                                                <button id="CreateCountryButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#CountryCreateModal">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </span>
                                        </div>
                                        <span id="errCoun" class="error" style="display:none">This field is required.</span>
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">Province</label>
                                        <div class="input-group">
                                            <select name="ProvinceId" id="lbProvinces" class="selectpicker form-control" tabindex="-1" data-live-search="true" required>
                                                <option value=0>-- Select --</option>
                                                @foreach (var item in Model.Provinces)
                                                {
                                                    if (Model.Client.ProvinceId == item.Id)
                                                    {
                                                        <option value="@item.Id" selected>@item.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Id">@item.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span class="input-group-btn">
                                                <button id="CreateProvinceButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#ProvinceCreateModal">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </span>
                                        </div>
                                        <span id="errProv" class="error" style="display:none">This field is required.</span>
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4 ">
                                    <div class="form-group">
                                        <label for="Client">City</label>
                                        <div class="input-group">
                                            <select name="CityId" id="lbCities" class="selectpicker form-control" tabindex="-1" data-live-search="true" required>
                                                <option value=0>-- Select --</option>
                                                @foreach (var item in Model.Cities)
                                                {
                                                    if (Model.Client.CityId == item.Id)
                                                    {
                                                        <option value="@item.Id" selected>@item.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Id">@item.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span class="input-group-btn">
                                                <button id="CreateCityButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#CityCreateModal">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </span>
                                        </div>
                                        <span id="errCity" class="error" style="display:none">This field is required.</span>
                                    </div>
                                </div>
                                <div class="col-md-12 col-xl-12 ">
                                    <div class="form-group">
                                        <label for="Client">Address</label>
                                        <textarea id="address" name="Address" maxlength="328" class="validate form-control" asp-for="@Model.Client.Address" required></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-xl-6">
                                    <div class="form-group">
                                        <label for="Client">Assigned To</label>
                                        <input id="AssignedToId" type="hidden" name="AssignedToId" value="@Model.Client.AssignedToId" />
                                        <input type="text" id="AssignedTo" name="AssignedTo" placeholder="Type name to search" class="validate form-control" value="@Model.Client.AssignedTo" required maxlength="128">
                                    </div>
                                </div>
                                <div class="col-md-6 col-xl-6">
                                    <div class="form-group">
                                        <label for="Client">Assigned Email</label>
                                        <input type="text" id="AssignedToEmail" name="AssignedToEmail" class="validate form-control" value="@Model.Client.AssignedToEmail" disabled>
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="display:none">
                                <div class="col-md-4 col-xl-4">
                                    <label for="Client">Status</label>
                                    <select id="StatusId2" name="StatusId2" class="selectpicker form-control">
                                        @if (Model.Client.StatusId == 1)
                                        {
                                            <option value="1" selected>Lead</option>
                                            <option value="2">Client</option>
                                        }
                                        else if (Model.Client.StatusId == 2)
                                        {
                                            <option value="1">Lead</option>
                                            <option value="2" selected>Client</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

