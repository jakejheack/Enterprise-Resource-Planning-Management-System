@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@{
    ViewBag.CurrentPageName = PageNames.Quotations_Details;
}
@section scripts
    {
    <script src="~/view-resources/Views/Quotations/Details.js" asp-append-version="true"></script>
}
@section Styles
    {
    <link rel="stylesheet" href="~/css/print.css" type="text/css" media="print" />
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>
                            Quotation Details
                            <span id="StatusBadge"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_Quotations_Export))
                    {
                        <div id="PrintMenuButton" class="btn-group" role="group">
                            <button id="btnGroupDrop2" type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-print"></i>
                                Print
                            </button>
                            <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
                                <a id="PrintButton" class="dropdown-item" href="#">&nbsp;&nbsp;Quotation</a>
                                <a id="PrintActualButton" class="dropdown-item" href="#">&nbsp;&nbsp;Actual</a>
                            </div>
                        </div>
                        @*<button id="PrintButton" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i>&nbsp; Print</button>*@
                    }
                    @*@if (IsGranted(PermissionNames.Pages_Quotations_Edit))
                    {
                        <button id="SaveButton" class="btn btn-outline-primary btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Update</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Quotations_Submit))
                    {
                        <button id="SubmitButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Submit</button>
                        <button id="ReviseButton" class="btn btn-outline-danger btn-sm" hidden><i class="fa fa-edit"></i>&nbsp; Revise</button>
                    }*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <form id="QuotationForm" name="QuotationForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
            <div class="row clearfix">
                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="Product">Series</label>
                                        <div class="input-group">
                                            <input id="Id" type="hidden" value="@ViewBag.Id" name="Id">
                                            <input id="RefNo" class="form-control font-weight-bold" disabled type="text" name="RefNo" required>
                                            <input id="Code" type="hidden" name="Code">
                                            <input id="Series" type="hidden" name="SeriesTypeId">
                                            <input id="StatusId" type="hidden" name="StatusId">
                                            <input id="QuotationCode" type="hidden" name="QuotationCode">
                                            <input id="RevisionNo" type="hidden" name="RevisionNo">
                                            <input id="Prefix" type="hidden" name="Prefix">
                                            <div class="input-group-addon" style="padding: 0 0 0 0 !important; border: 0 !important;width:90px">
                                                <input type="hidden" id="RevisionNo" name="RevisionNo" />
                                                <select id="sRevisionNo" name="sRevisionNo" class="selectpicker form-control"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6" hidden>
                                    <div class="form-group">
                                        <label for="Product">Company</label>
                                        <div class="input-group">
                                            <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                            <label id="CompanyAddress" style="display: none;" class="hidden">
                                                Office Address: G/F Warehouse C/M<br />
                                                Greenfield Industrial Complex, Km. 14 Merville Road,<br />
                                                Merville Industrial Complex, Paranaque City<br />
                                                Tel: +63(2)776-1684 Fax: +63(2)776-1684
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Date</label>
                                        <div class="input-group date" data-provide="datepicker">
                                            <input type="text" id="TransactionTime" name="TransactionTime" class="form-control date-picker" required>
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Request</label>
                                        <input type="hidden" id="PrevRequestId" name="PrevRequestId">
                                        <input type="hidden" id="RequestId" name="RequestId">
                                        <input type="hidden" id="RequestCode" name="RequestCode">
                                        <input type="text" id="Request" name="Request" class="form-control" placeholder="Type here">
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Contact Person</label>
                                        <input id="ContactPersonId" type="hidden" name="ContactPersonId" required>
                                        <input id="ContactPersonPosition" type="hidden" name="ContactPersonPosition" required>
                                        <input id="ContactPerson" class="form-control" type="text" name="ContactPerson" readonly>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Client</label>
                                        <input id="ClientId" type="hidden" name="ClientId" required>
                                        <input id="ClientName" class="form-control" type="text" name="Client" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddOrderType">Order Type</label>
                                        <select name="OrderTypeId" id="OrderTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Project</label>
                                        <input id="Project" class="form-control" type="text" name="Project" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddPriceType">Price Type</label>
                                        <select name="PricingTypeId" id="PricingTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Sales Agent</label>
                                        <input id="ClientTelephone" type="hidden" name="ClientTelephone" required>
                                        <input id="SalesAgentId" type="hidden" name="SalesAgentId" required>
                                        <input id="SalesAgent" class="form-control" type="text" name="SalesAgent" placeholder="Type here" required>
                                        <input id="SalesAgentMobile" class="form-control" type="hidden" name="SalesAgentMobile" required>
                                        <input id="SalesAgentEmail" class="form-control" type="hidden" name="SalesAgentEmail" required>
                                        <input id="SalesAgentPosition" class="form-control" type="hidden" name="SalesAgentPosition" required>
                                        <input id="ManagerId" class="form-control" type="hidden" name="ManagerId" required>
                                        <input id="Manager" class="form-control" type="hidden" name="Manager" required>
                                        <input id="ManagerPosition" class="form-control" type="hidden" name="ManagerPosition" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
