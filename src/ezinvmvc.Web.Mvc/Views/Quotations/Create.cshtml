@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Sales
@{
    ViewBag.CurrentPageName = PageNames.Quotations_Create;
}
@model QuotationListViewModel

@section scripts
    {
    <script src="~/view-resources/Views/Quotations/Create.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <input type="text" id="h1" value="@Model.EmpId" hidden>
                    <div class="page-title">
                        <h1>Create Quotation</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    <button id="SaveButton" class="btn btn-outline-primary btn-sm"><i class="fa fa-save"></i>&nbsp; Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <form id="QuotationForm" name="QuotationForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
            <div class="row clearfix">
                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row" hidden>
                                <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="Product">Series</label>
                                        <div class="input-group">
                                            <input id="ReRevisionNo" type="hidden" value="1" name="RevisionNo">
                                            <select name="SeriesTypeId" id="Series" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Date</label>
                                        <div class="input-group date" data-provide="datepicker">
                                            <input type="text" name="TransactionTime" class="form-control date-picker" required>
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Request</label>
                                        <input type="hidden" id="DefaultDiscount" name="DefaultDiscount">
                                        <input type="hidden" id="RequestId" name="RequestId">
                                        <input type="hidden" id="RequestCode" name="RequestCode">
                                        <input type="hidden" id="LeadId" name="LeadId">
                                        <input type="text" id="Request" name="Request" class="form-control" placeholder="Type here">
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Contact Person</label>
                                        <input id="ContactPersonId" type="hidden" name="ContactPersonId" required>
                                        <input id="ContactPerson" class="form-control" type="text" name="ContactPerson" readonly>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Client Name/Company Name</label>
                                        <input id="ClientId" type="hidden" name="ClientId" required>
                                        <input id="ClientName" class="form-control" type="text" name="Client" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddOrderType">Order Type</label>
                                        <select name="OrderTypeId" id="OrderTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="txtClient">Project</label>
                                        <input id="Project" class="form-control" type="text" name="Project" readonly>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddPriceType">Price Type</label>
                                        <select name="PricingTypeId" id="PricingTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="SalesAgent">Account Executive</label>
                                        <input id="SalesAgentId" type="hidden" name="SalesAgentId" required>
                                        <input id="SalesAgent" class="form-control" type="text" name="SalesAgent" placeholder="Type here" required>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="ddPriceType">Deadlines</label>
                                        <input type="text" id="Deadlines" name="Deadlines" class="form-control date-picker">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row clearfix">
                <div class="col-md-12 col-xl-12">
                    <div class="card" id="accordion">
                        <div class="card-header">
                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                                <span class="glyphicon glyphicon-file">
                                </span>Address
                            </a>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6  col-xl-6">
                                        <input id="ClientEmail" type="text" name="ClientEmail" class="form-control" readonly hidden>
                                        <div class="form-group">
                                            <label>Delivery Address</label>
                                            <textarea id="DeliveryAddress" name="DeliveryAddress" rows="4" class="form-control" readonly></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-6  col-xl-6">
                                        <div class="form-group">
                                            <label for="ddPriceType">Billing Address</label>
                                            <textarea id="ClientAddress" name="ClientAddress" rows="4" class="form-control" readonly></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-md-12 col-xl-12">
                    <div class="card" id="accordion">
                        <div class="card-header">
                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                                <span class="glyphicon glyphicon-file">
                                </span>Notes
                            </a>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in show">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12  col-xl-12">
                                        <div class="form-group">
                                            <textarea id="Notes" name="Notes" class="form-control" rows="5" placeholder="Notes" maxlength="328"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row">
                                <div class="col-md-12  col-xl-12">
                                    <div class="form-group">
                                        <table id="ItemsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                            <thead>
                                                <tr>
                                                    <th width="5%">#</th>@*0*@
                                                    <th width="35%">Item</th>@*1*@
                                                    <th width="5%">Type</th>@*2 Option*@
                                                    <th width="15%">Qty</th>@*[2] 3*@
                                                    <th width="15%">Price</th>@*[3] 4 Price*@
                                                    <th width="10%">Less</th>@*[4] 5 DiscTotal*@
                                                    <th width="15%">Amount</th>@*[5] 6 Total*@
                                                    <th width="5%"></th>@*[6] 7 Total*@
                                                    <th>8</th>@*[7] 8 ProductId*@
                                                    <th>9</th>@*[8] 9 Description*@
                                                    <th>10</th>@*[9] 10 OrderQty*@
                                                    <th>11</th>@*[10] 11 UnitId*@
                                                    <th>12</th>@*[11] 12 Disc1*@
                                                    <th>13</th>@*[12] 13 DiscType1*@
                                                    <th>14</th>@*[13] 14 Disc2*@
                                                    <th>15</th>@*[14] 15 DiscType2*@
                                                    <th>16</th>@*[15] 16 Disc3*@
                                                    <th>17</th>@*[16] 17 DiscType3*@
                                                    <th>18</th>@*[17] 18 GroupName*@
                                                    <th>19</th>@*[18] 19 Reference*@
                                                    @**MARC qi_option 07212022*@
                                                    <th>20</th>@*20 Option*@
                                                    <th>color</th>@*21 Option*@
                                                    @**MARC qi_option 07212022*@
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 col-xl-12">
                                    <div class="card border border-success" id="accordion">
                                        <div class="card-header">
                                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                                                Add Item
                                            </a>
                                        </div>
                                        <div id="collapseTwo" class="panel-collapse collapse in">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Type</label>
                                                            <select id="ItemType" name="ItemType" class="selectpicker form-control">
                                                                <option value="1">Actual</option>
                                                                <option value="0">Option</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Color</label>
                                                            <input id="Color" name="Color" type="text" class="form-control" placeholder="Color">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Name</label>
                                                            <input id="ProductId" type="hidden">
                                                            <input id="ProductName" type="text" class="form-control" placeholder="Type here">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Code</label>
                                                            <input id="ProductCode" type="text" class="form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="row">
                                                            <div class="col-md-6 col-xl-6">
                                                                <div class="form-group">
                                                                    <label>Quantity</label>
                                                                    <input id="Quantity" type="text" name="Quantity" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6  col-xl-6">
                                                                <div class="form-group">
                                                                    <label>Stocks</label>
                                                                    <input id="Stocks" type="text" class="form-control" readonly>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="row">
                                                            <div class="col-md-6  col-xl-6">
                                                                <div class="form-group">
                                                                    <label>Unit</label>
                                                                    <select id="Units" class="selectpicker form-control" tabindex="-1" data-live-search="true"></select>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6  col-xl-6">
                                                                <div class="form-group">
                                                                    <label>Price</label>
                                                                    <input id="Price" type="text" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Description</label>
                                                            <textarea id="PerDescription" class="form-control" rows="3" maxlength="2000"></textarea>
                                                        </div>
                                                        <div class="card" id="accordiondiscount">
                                                            <div class="card-header">
                                                                <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                                                                    Add Discount
                                                                </a>
                                                            </div>
                                                            <div id="collapseThree" class="panel-collapse collapse in">
                                                                <div class="card-body">
                                                                    <div class="row">
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Discount</label>
                                                                                <input id="Discount1" type="text" value="0" class="form-control font-weight-bold text-danger" onkeypress="return decimalOnly(this.id);">
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Type</label>
                                                                                <select id="DiscountType1" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                    <option value=2>Percent</option>
                                                                                    <option value=1>Value</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row">
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Discount</label>
                                                                                <input id="Discount2" type="text" value="0" class="form-control  font-weight-bold text-danger" onkeypress="return decimalOnly(this.id);">
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Type</label>
                                                                                <select id="DiscountType2" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                    <option value=2>Percent</option>
                                                                                    <option value=1>Value</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row">
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Discount</label>
                                                                                <input id="Discount3" type="text" value="0" class="form-control  font-weight-bold text-danger" onkeypress="return decimalOnly(this.id);">
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-6  col-xl-6">
                                                                            <div class="form-group">
                                                                                <label>Type</label>
                                                                                <select id="DiscountType3" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                    <option value=2>Percent</option>
                                                                                    <option value=1>Value</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <label>Group Name</label>
                                                            <input id="GroupName" type="text" class="form-control">
                                                        </div>
                                                        <div class="form-group">
                                                            <img id="ProductImage" src="" class="img-fluid img-thumbnail" style="margin-top:25px" alt="your image" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6  col-xl-6">

                                                    </div>
                                                    <div class="col-md-6  col-xl-6">

                                                        <div class="form-group  text-right">
                                                            <button id="AddItemButton" class="btn btn-outline-success btn-sm"><i class="fa fa-plus"></i>&nbsp; Add</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 col-xl-12">
                                    <div class="card border border-success" id="accordion4">
                                        <div class="card-header">
                                            <a data-toggle="collapse" data-parent="#accordion4" href="#collapsefour">
                                                Add MTO and Other item
                                            </a>
                                        </div>
                                        <div id="collapsefour" class="panel-collapse collapse in">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-12  col-xl-12" hidden>
                                                        <div class="form-group">
                                                            @*<label>Others</label>
                                                            <textarea id="Others" name="Others" class="form-control" rows="5" maxlength="3000"></textarea>
                                                            <label>Count :</label><span id="characters"></span>*@

                                                            <input id="Oitemno" name="Oitemno" type="hidden" class="form-control" placeholder="Color">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12  col-xl-12">
                                                        <div class="form-group">
                                                            <table id="OItemsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="width: 7%">No</th>@*0*@
                                                                        <th style="width: 15%">Name</th>@*1*@
                                                                        <th style="width: 10%">Area</th>@*2*@
                                                                        <th style="width: 36%">Description</th>@*3 Option*@
                                                                        <th style="width: 15%">Dimension</th>@*4*@
                                                                        <th style="width: 10%">Qty</th>@*5Price*@
                                                                        <th style="width: 7%"></th>@*6Total*@
                                                                        <th>Id</th>@*7*@
                                                                        <th>RFQId</th>@*8*@
                                                                    </tr>
                                                                </thead>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <input id="Oid" name="Oid" type="hidden">
                                                            <input id="OrfqId" name="OrfqId" type="hidden">
                                                            <input id="OName" name="OName" type="text" class="form-control" placeholder="Name" maxlength="328">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <input id="OArea" name="OArea" type="text" class="form-control" placeholder="Area" maxlength="328">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12  col-xl-12">
                                                        <div class="form-group">
                                                            <textarea id="ODescription" name="ODescription" type="text" class="form-control" placeholder="Description 800 character only" maxlength="800" rows="3"></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6  col-xl-6">
                                                        <div class="form-group">
                                                            <input id="ODimension" name="ODimension" type="text" class="form-control" placeholder="Dimension" maxlength="328">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3  col-xl-3">
                                                        <div class="form-group">
                                                            <input id="OQuantity" type="text" name="OQuantity" class="form-control" placeholder="Qty" onkeypress="return decimalOnly(this.id);">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <button id="OAddItemButton" name="OAddItemButton" class="btn btn-outline-success" style="width:100%"><i class="fa fa-plus"></i>&nbsp; Add</button>
                                                        <div class="btn-group" role="group" aria-label="Basic example" style="width:100%">
                                                            <button id="OUpdateItemButton" class="btn btn-outline-danger" style="width:100%"><i class="fa fa-edit"></i>&nbsp; Update</button>
                                                            <button id="OCancelItemButton" class="btn btn-outline-info"><i class="fa fa-undo"></i>&nbsp; Cancel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <label>Others</label>
                                                <textarea id="Others" name="Others" class="form-control" rows="5" maxlength="3000"disabled></textarea>
                                                <label>Count :</label><span id="characters"></span>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row clearfix">
                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="row form-group">
                                        <div class="col-md-3 col-xl-3 text-left" style="padding-top:5px">
                                            <label for="email-input" class=" form-control-label">Payment Term</label>
                                        </div>
                                        <div class="col-md-8 col-xl-8">
                                            <select name="PaymentTermId" id="PaymentTerms" class="selectpicker form-control" tabindex="-1" data-live-search="true"></select>
                                            <input type="text" id="OtherTerms" name="OtherTerms" class="form-control" placeholder="Type Other Terms">

                                        </div>
                                        <div class="col-md-1 col-xl-1 text-left">
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-md-3 col-xl-3 text-left" style="padding-top:5px">
                                            <label for="email-input" class=" form-control-label">Delivery Type</label>
                                        </div>
                                        <div class="col-md-8 col-xl-8">
                                            <select name="DeliveryTypeId" id="DeliveryTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true"></select>
                                        </div>
                                        <div class="col-md-1 col-xl-1 text-left">
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-md-3 col-xl-3 text-left" style="padding-top:5px">
                                            <label for="email-input" class=" form-control-label">Tax Type</label>
                                        </div>
                                        <div class="col-md-8 col-xl-8">
                                            <select name="TaxTypeId" id="TaxTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true"></select>
                                        </div>
                                        <div class="col-md-1 col-xl-1 text-left">
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-md-3 col-xl-3 text-left" style="padding-top:5px">
                                            <label for="email-input" class=" form-control-label">Warranty</label>
                                        </div>
                                        <div class="col-md-8 col-xl-8">
                                            <select name="WarrantyTypeId" id="WarrantyTypes" class="selectpicker form-control" tabindex="-1" data-live-search="true" multiple required></select>
                                        </div>
                                        <div class="col-md-1 col-xl-1 text-left">
                                        </div>
                                    </div>
                                    <div class="row form-group">
                                        <div class="col-md-3 col-xl-3 text-left" style="padding-top:5px">
                                            <label for="email-input" class=" form-control-label">Package Cost</label>
                                        </div>
                                        <div class="col-md-8 col-xl-8">
                                            <input type="text" id="PackageCost" name="PackageCost" class="form-control text-right text-danger">
                                        </div>
                                        <div class="col-md-1 col-xl-1 text-left">
