@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Sales
@{
    ViewBag.CurrentPageName = PageNames.AttAdjReport;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/AttAdjReport.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                @*<div class="page-header float-left">
                    <div class="page-title">
                        <h1>Attendance Adjustment Report</h1>
                    </div>
                </div>*@
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px;padding-bottom:10px">
                        <button id="AttendanceList" style="width:100%" data-toggle="modal" data-target="#AttList" class="btn btn-outline-success btn-sm"><i class="fa fa-list-ol"></i>&nbsp;Filter&nbsp;Data</button>
                        <button name="ExportToExcelButton" id="ExportToExcelButton" value="Export" type="button" class="btn btn-outline-dark btn-sm"><i class="fa fa-file-excel-o"></i> Export</button>
                        <button name="PrintActualButton" id="PrintActualButton" value="Print" type="button" class="btn btn-outline-primary btn-sm"><i class="fa fa-print"></i> Print</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div id="PrintTable2" style="background-color: white;">
                    <div class="col-md-12 col-xl-12">
                        <input id="attid" name="attid" type="text" class="form-control" hidden required placeholder="Time keeping Code" value="0">
                        <input id="dept" name="dept" type="text" class="form-control" hidden required placeholder="companyId" value="0">
                        <div class="page-title center" style="text-align:center">
                            <h4>Attendance Adjustment Report</h4>
                        </div>
                        <div class="page-title center" style="text-align:center">
                            <label id="Cutoff" name="Cutoff"></label>
                        </div>
                        <div class="page-title center" style="text-align:center">
                            <h4>ACTIVE ONLY</h4>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="coveredDate" name="coveredDate"></label>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="Company" name="Company"></label>
                        </div>
                        <table id="AttadjTable" class="table table-striped table-bordered table-hover dt-responsive nowrap" style="width: 1127px;font-size: 12px;">
                            <thead>
                                <tr>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                    <th style="font-size:smaller; background: lightgray;">Comp</th>
                                    <th style="font-size:smaller; background: lightgray;" width:5%">Time Keeping Code</th>
                                    <th style="font-size:smaller; width:5%; background: lightgray;">Emp&nbsp;Code</th>
                                    <th style="font-size:smaller;  width:20%; background: lightgray;">Name</th>
                                    <th style="font-size:smaller; background: lightgray;">Salary</th>
                                    <th style="font-size:smaller; background: lightgray;">Absent</th>
                                    <th style="font-size:smaller; background: lightgray;">Late</th>
                                    <th style="font-size:smaller; background: lightgray;">Utime</th>
                                    <th style="font-size:smaller; background: lightgray;">OT</th>
                                    <th style="font-size:smaller; background: lightgray;">Leave</th>
                                    <th style="font-size:smaller; background: lightgray;">Others</th>
                                    <th style="font-size:smaller; background: lightgray;">Days</th>
                                    <th style="font-size:smaller; background: lightgray;">Total</th>
                                </tr>

                            </thead>
                            <tbody></tbody>
                            <tfoot id="tfooter" style="background: gainsboro;">
                                <tr>
                                    <th colspan="5" style="text-align:right!important">Total:</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AttList" tabindex="-1" role="dialog" aria-labelledby="AttListLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Attendance List</span>
                </h6>
            </div>
            <div class="modal-body">
                <table id="AttendanceTable" class="table table-striped table-hover dt-responsive nowrap" style="padding: 10px;">
                    <thead>
                        <tr>
                            <th width="20%">Date</th>
                            <th width="40%">Timekeeping&nbsp;Code</th>
                            <th width="40%">Company</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>
