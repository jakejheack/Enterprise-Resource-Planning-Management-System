@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Sales
@{
    ViewBag.CurrentPageName = PageNames.Employee201Report;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/Employee201Report.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px;padding-bottom:10px">
                        <button id="Modal" style="width:100%" data-toggle="modal" data-target="#AttList" class="btn btn-outline-success btn-sm"><i class="fa fa-list-ol"></i>&nbsp;Filter&nbsp;Data</button>
                        <button name="ExportToExcelButton" id="ExportToExcelButton" value="Export" type="button" class="btn btn-outline-dark btn-sm"><i class="fa fa-file-excel-o"></i> Export</button>
                        @*<button name="PrintActualButton" id="PrintActualButton" value="Print" type="button" class="btn btn-outline-primary btn-sm"><i class="fa fa-print"></i> Print</button>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div id="PrintTable2" style="background-color: white;">
                    <div class="col-md-12 col-xl-12">
                        <input id="attid" name="attid" type="text" class="form-control" hidden required placeholder="Time keeping Code" value="0">
                        <input id="dept" name="dept" type="text" class="form-control" hidden required placeholder="companyId" value="0">
                        <div class="page-title center" style="text-align:center">
                            <h4>EMPLOYEE 201 REPORTS</h4>
                        </div>
                        <div class="page-title center" style="text-align:center">
                            <h4>ACTIVE ONLY</h4>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="Company" name="Company"></label>
                        </div>
                        <table id="201Table" name="201Table" class="table table-striped table-bordered table-hover dt-responsive nowrap" style="width: 1127px;font-size: 12px;">
                            <thead>
                                <tr>
                                    <th style="font-size:smaller; background: lightgray;">Emp Code</th>
                                    <th style="font-size:smaller; background: lightgray;">Name</th>
                                    <th style="font-size:smaller; background: lightgray;">Position</th>
                                    <th style="font-size:smaller; background: lightgray;">Department</th>
                                    <th style="font-size:smaller; background: lightgray;">Company</th>
                                    <th style="font-size:smaller; background: lightgray;">Bank Name</th>
                                    <th style="font-size:smaller; background: lightgray;">Account No</th>
                                    <th style="font-size:smaller; background: lightgray;">Monthly</th>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                </tr>

                            </thead>
                            @*<tbody></tbody>
                                <tfoot id="tfooter" style="background: gainsboro;">
                                    <tr>
                                        <th colspan="5" style="text-align:right!important">Total:</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>*@
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="AttList" tabindex="-1" role="dialog" aria-labelledby="AttListLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Filter</span>
                </h6>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 col-xl-4">
                        <div class="form-group">
                            <label>Search By</label>
                            <div class="form-group">
                                <select name="SearchBy" id="SearchBy" class="selectpicker form-control">
                                    <option value=0>-- Search By --</option>
                                    <option value="code">Employee Code</option>
                                    <option value="name">Employee Name</option>
                                    <option value="position">Position</option>
                                    <option value="company">Company</option>
                                    <option value="department">Department</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8 col-xl-8">
                        <div class="form-group">
                            <label>FIlter By</label>
                            <input type="text" id="filtername" name="filtername" class="form-control ">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" name="show" id="show" class="btn btn-outline-info">Show</button>
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>


