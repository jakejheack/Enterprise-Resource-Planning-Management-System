@using ezinvmvc.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.SalesOrderReport;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/SalesOrderReport.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Sales Order Report</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px">
                        <button name="btnprint" value="Print" type="button" class="btn btn-outline-primary btn-sm" id="btnprint"><i class="fa fa-print"></i> Print</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div class="row" hidden>
                    <label id="CompanyAddress" style="display: none;" class="hidden">
                        Office Address: G/F Warehouse C/M<br />
                        Greenfield Industrial Complex, Km. 14 Merville Road,<br />
                        Merville Industrial Complex, Paranaque City<br />
                        Tel: +63(2)776-1684 Fax: +63(2)776-1684
                    </label>
                </div>
                <div class="row align-items-center m--margin-bottom-10">
                    <div class="col-md-2 col-xl-2">
                        <div class="form-group">
                            <label style="margin-bottom:0px;">From</label>
                            <input type="text" id="DateFrom" name="DateFrom" class="input-sm form-control-sm form-control date-picker">
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <div class="form-group">
                            <label style="margin-bottom:0px;">To</label>
                            <input type="text" id="DateTo" name="DateTo" class="input-sm form-control-sm form-control date-picker">
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <div class="form-group">
                            <label style="margin-bottom:0px;">Search By</label>
                            <select id="Types" class="selectpicker form-control input-sm form-control-sm">
                                <option value="0">-- Select --</option>
                                <option value="1">Manager</option>
                                <option value="2">AE</option>
                                <option value="3">Client</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-4">
                        <div class="form-group">
                            <label style="margin-bottom:0px;"></label>
                            <input type="text" id="SearchFilter" class="form-control m-input input-sm form-control-sm" placeholder="Some text here..." value="">
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <div class="form-group">
                            <label style="margin-bottom:0px;"></label>
                            <button id="SearchButton" class="btn btn-primary btn-block btn-sm" type="submit">Search</button>
                        </div>
                    </div>
                    @*<table id="ListTable" class="table table-striped table-bordered table-hover dt-responsive nowrap">*@
                    <table id="ListTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th style="font-size:smaller; background: lightgray;"></th>
                                <th style="font-size:smaller; background: lightgray;">SO&nbsp;#</th>
                                <th style="font-size:smaller; background: lightgray;">Date&nbsp;Trans</th>
                                <th style="font-size:smaller; background: lightgray; width:25%">Company</th>
                                <th style="font-size:smaller; background: lightgray; width:25%">AE's</th>
                                <th style="font-size:smaller; background: lightgray; width:25%">AM's</th>
                                <th style="font-size:smaller; background: lightgray;">PO/Ref&nbsp;No</th>
                                <th style="font-size:smaller; background: lightgray;">PO&nbsp;Date</th>
                                <th style="font-size:smaller; background: lightgray;">Amount</th>
                                <th style="font-size:smaller; background: lightgray;">Total</th>
                                <th style="font-size:smaller; background: lightgray;">Disc</th>
                                <th style="font-size:smaller; background: lightgray;">TPC</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



