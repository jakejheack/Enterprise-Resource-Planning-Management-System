@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@{
    ViewBag.CurrentPageName = PageNames.OTSummaryReport;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/OTSummaryReport.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="float-left">
                    <div class="btn-group" role="group" style=" padding-top:10px;padding-bottom:10px">
                        <select name="sectors" id="sectors" style=" width: 130px;" tabindex="-1" data-live-search="true"></select>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px;padding-bottom:10px">
                        <button id="AttendanceList" style="width:100%" data-toggle="modal" data-target="#AttList" class="btn btn-outline-success btn-sm"><i class="fa fa-list-ol"></i>&nbsp;Filter&nbsp;Data</button>
                        <button name="ExportToExcelButton" id="ExportToExcelButton" value="Export" type="button" class="btn btn-outline-dark btn-sm"><i class="fa fa-file-excel-o"></i> Export</button>
                        <button name="PrintActualButton" id="PrintActualButton" value="Print" type="button" class="btn btn-outline-primary btn-sm"><i class="fa fa-print"></i> Print Acknowledgement</button>
                        @*@if (IsGranted(PermissionNames.Acknowledgement_NetPayPrint))
                            {
                                <button name="PrintActualButton2" id="PrintActualButton2" value="Print" type="button" class="btn btn-outline-primary btn-sm"><i class="fa fa-print"></i> Print with NetPay</button>
                            }*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div id="PrintTable" style="background-color: white;">
                    <div class="col-md-12 col-xl-12">
                        <input id="attid" name="attid" type="text" class="form-control" hidden required placeholder="" value="0">
                        <input id="dept" name="dept" type="text" class="form-control" hidden required placeholder="companyId" value="0">
                        <div class="page-title center" style="text-align:left">
                            <h4>Overtime Summary Report</h4>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="coveredDate" name="coveredDate"></label>
                        </div>
                        <table id="LoanTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th style="font-size:smaller; background: lightgray; width: 50px;">ctrl</th> @*ctrl*@
                                    <th style="font-size:smaller; background: lightgray;">COMP</th>@*COMP*@
                                    <th style="font-size:smaller; background: lightgray;">DEPT</th>@*DEPT*@
                                    <th style="font-size:smaller; background: lightgray;">NAME</th>@*Comp*@
                                    <th style="font-size:smaller; background: lightgray;">CODE</th>@*App No*@
                                    <th style="font-size:smaller; background: lightgray;"></th>@*AttId*@
                                    <th style="font-size:smaller; background: lightgray;">RG</th>@*RestDay*@
                                    <th style="font-size:smaller; background: lightgray;">RD</th>@*RestDay*@
                                    <th style="font-size:smaller; background: lightgray;">SH</th>@*SpecialHoliday*@
                                    <th style="font-size:smaller; background: lightgray;">LH</th>@*LegalHoliday*@
                                    <th style="font-size:smaller; background: lightgray;">SHRD</th>@*SpecialHolidayRestday*@
                                    <th style="font-size:smaller; background: lightgray;">LHRD</th>@*LegalHolidayRestday*@
                                    <th style="font-size:smaller; background: lightgray;">RGOT</th>@*ReguralOT*@
                                    <th style="font-size:smaller; background: lightgray;">RDOT</th>@*RestDayOT*@
                                    <th style="font-size:smaller; background: lightgray;">SHOT</th>@*SpecialHolidayOT*@
                                    <th style="font-size:smaller; background: lightgray;">LHOT</th>@*LegalHolidayOT*@
                                    <th style="font-size:smaller; background: lightgray;">SHRDOT</th>@*SpecialHolidayRestdayOT*@
                                    <th style="font-size:smaller; background: lightgray;">LHRDOT</th>@*LegalHolidayRestdayOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDRG</th>@*NDRegural*@
                                    <th style="font-size:smaller; background: lightgray;">NDRD</th>@*NDRestDay*@
                                    <th style="font-size:smaller; background: lightgray;">NDSH</th>@*NDSpecialHoliday*@
                                    <th style="font-size:smaller; background: lightgray;">NDLH</th>@*NDLegalHoliday*@
                                    <th style="font-size:smaller; background: lightgray;">NDSHRD</th>@*NDSpecialHolidayRestday*@
                                    <th style="font-size:smaller; background: lightgray;">NDLHRD</th>@*NDLegalHolidayRestday*@
                                    <th style="font-size:smaller; background: lightgray;">NDRGOT</th>@*NDReguralOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDRDOT</th>@*NDRestDayOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDSHOT</th>@*NDSpecialHolidayOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDLHOT</th>@*NDLegalHolidayOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDSHRDOT</th>@*NDSpecialHolidayRestdayOT*@
                                    <th style="font-size:smaller; background: lightgray;">NDLHRRDOT</th>@*NDLegalHolidayRestdayOT*@
                                    <th style="font-size:smaller; background: lightgray;">TOTAL</th>@*Total*@
                                    <th style="font-size:smaller; background: lightgray;"></th>@*Total2*@
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot id="tfooter" style="background: gainsboro;">
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>TOTAL:</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AttList" tabindex="-1" role="dialog" aria-labelledby="AttListLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Attendance List</span>
                </h6>
            </div>
            <div class="modal-body">
                <table id="AttendanceTable" class="table table-striped table-hover dt-responsive nowrap" style="padding: 10px;">
                    <thead>
                        <tr>
                            <th width="20%">#</th>
                            <th width="20%">Timekeeping&nbsp;Code</th>
                            <th width="40%">Period</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>


