@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Sales
@{
    ViewBag.CurrentPageName = PageNames.Month13;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/Month13t.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                        <div class="page-title">
                            <h1>13th Month Report</h1>
                        </div>
                    </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px; padding-bottom:10px">
                        <button id="AttendanceList" style="width:100%" data-toggle="modal" data-target="#AttList" class="btn btn-outline-success btn-sm"><i class="fa fa-list-ol"></i>&nbsp;Filter&nbsp;Data</button>
                        <button name="ExportToExcelButton" id="ExportToExcelButton" value="Export" type="button" class="btn btn-outline-dark btn-sm"><i class="fa fa-file-excel-o"></i> Export</button>
                        <button name="PrintActualButton" id="PrintActualButton" value="Print" type="button" class="btn btn-outline-primary btn-sm"><i class="fa fa-print"></i> Print</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div id="PrintTable3" style="background-color: white;">
                    <div class="col-md-12 col-xl-12">
                        <input id="attid" name="attid" type="text" class="form-control" hidden required placeholder="Time keeping Code" value="0">
                        <div class="page-title center" style="text-align:left ;font-size: 25px;">
                            <label id="Company" name="Company"></label> <label id="coveredDate" name="coveredDate"></label>
                        </div>

                        <table id="13monthTable" class="table table-striped table-bordered table-hover dt-responsive nowrap">
                            <thead>
                                <tr>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                    <th style="font-size:smaller; background: lightgray;">Comp</th>
                                    <th style="font-size:smaller; background: lightgray;">Code</th>
                                    <th style="font-size:smaller; background: lightgray;">Name</th>
                                    <th style="font-size:smaller; background: lightgray;">Month</th>
                                    <th style="font-size:smaller; background: lightgray;">Year</th>
                                    <th style="font-size:smaller; background: lightgray;">Jan</th>
                                    <th style="font-size:smaller; background: lightgray;">Feb</th>
                                    <th style="font-size:smaller; background: lightgray;">Mar</th>
                                    <th style="font-size:smaller; background: lightgray;">Apr</th>
                                    <th style="font-size:smaller; background: lightgray;">May</th>
                                    <th style="font-size:smaller; background: lightgray;">Jun</th>
                                    <th style="font-size:smaller; background: lightgray;">Jul</th>
                                    <th style="font-size:smaller; background: lightgray;">Aug</th>
                                    <th style="font-size:smaller; background: lightgray;">Sept</th>
                                    <th style="font-size:smaller; background: lightgray;">Oct</th>
                                    <th style="font-size:smaller; background: lightgray;">Nov</th>
                                    <th style="font-size:smaller; background: lightgray;">Dec</th>
                                    <th style="font-size:smaller; background: lightgray;">13Month</th>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 12px;"></tbody>
                            <tfoot></tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AttList" tabindex="-1" role="dialog" aria-labelledby="AttListLabel" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Year</span>
                </h6>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 col-xl-6">
                        <label>Date</label>
                        <select name="SearchBy" id="SearchBy" class="selectpicker form-control">
                            <option value="2023">2023</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                            <option value="2028">2028</option>
                            <option value="2029">2029</option>
                            <option value="2030">2030</option>
                            <option value="2031">2031</option>
                            <option value="2032">2032</option>
                            <option value="2033">2033</option>
                            <option value="2034">2034</option>
                            <option value="2035">2035</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-xl-6">
                        <label>Date</label>
                        <select name="Comp" id="Comp" class="selectpicker form-control">
                            <option selected value="">Select</option>
                            <option value="MFT">MFT</option>
                            <option value="MSL">MSL</option>
                            <option value="ONE SECAI">ONE SECAI</option>
                            <option value="GLOBUS">GLOBUS</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" name="btnshow" id="btnshow" class="btn btn-outline-info">Show</button>
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>

