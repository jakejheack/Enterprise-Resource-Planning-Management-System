@using ezinvmvc.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.SalesOrderSummaryReport;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/SalesOrderSummaryReport.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Sales Order Summary Report</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px">
                        <button name="btnprint" value="Print" type="button" class="btn btn-outline-primary btn-sm" id="btnprint"><i class="fa fa-print"></i> Print</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        @* Filter *@
                        <div class="row align-items-center m--margin-bottom-10">
                            <div class="col-md-3 col-xl-3">
                                <div class="form-group">
                                    <input type="text" id="DateFrom" name="DateFrom" class="input-sm form-control-sm form-control date-picker" required>
                                </div>
                            </div>
                            <div class="col-md-3 col-xl-3">
                                <div class="form-group">
                                    <input type="text" id="DateTo" name="DateTo" class="input-sm form-control-sm form-control date-picker" required>
                                </div>
                            </div>
                            <div class="col-md-4 col-xl-4">
                                @*<select id="AEs" class="selectpicker form-control input-sm form-control-sm "  multiple data-live-search="true"></select>*@
                                <div class="form-group">
                                    <button id="btnsearch" class="btn btn-outline-primary btn-sm"><i class="fa fa-search"></i>&nbsp; Search</button>
                                </div>
                            </div>
                            <div class="col-md-12 col-xl-12">
                                <div class="form-group">
                                    <input type="text" id="ids" name="ids" class="input-sm form-control-sm" >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


