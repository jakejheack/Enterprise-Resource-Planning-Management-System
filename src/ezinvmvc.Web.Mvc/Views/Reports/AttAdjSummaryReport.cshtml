@using ezinvmvc.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.AttAdjSummaryReport;
}
@section scripts
    {
    <script src="~/view-resources/Views/Reports/AttAdjSummaryReport.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                @*<div class="page-header float-left">
                        <div class="page-title">
                            <h1>Attendance Adjustment Report</h1>
                        </div>
                    </div>*@
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right">
                    <div class="btn-group" role="group" style=" padding-top:10px">
                        <button id="AttendanceList" style="width:100%" data-toggle="modal" data-target="#AttList" class="btn btn-outline-success btn-sm"><i class="fa fa-list-ol"></i>&nbsp;Filter&nbsp;Data</button>
                        <button name="btnprint" value="Print" onclick="PrintMe('divid')" type="button" class="btn btn-outline-primary btn-sm" id="PrintElem"><i class="fa fa-print"></i> Print</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="card">
            <div class="card-body">
                <div id="PrintTable3" style="background-color: white;">
                    <div class="col-md-12 col-xl-12">
                        <input id="attid" name="attid" type="text" class="form-control" hidden required placeholder="Time keeping Code" value="0">
                        <input id="dept" name="dept" type="text" class="form-control" hidden required placeholder="companyId" value="0">
                        <div class="page-title center" style="text-align:center">
                            <h4>Attendance Summary Report</h4>
                        </div>
                        <div class="page-title center" style="text-align:center">
                            <label id="Cutoff" name="Cutoff"></label>
                        </div>
                        <div class="page-title center" style="text-align:center">
                            <h4>ACTIVE ONLY</h4>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="coveredDate" name="coveredDate"></label>
                        </div>
                        <div class="page-title center" style="text-align:left">
                            <label id="Company" name="Company"></label>
                        </div>
                        <table id="AttadjTable" class="table table-striped table-bordered table-hover dt-responsive nowrap">
                            <thead>
                                <tr>
                                    <th style="font-size:smaller; background: lightgray;"></th>
                                    <th style="font-size:smaller; background: lightgray;">Emp No</th>
                                    <th style="font-size:smaller; background: lightgray;" width:5%">Name</th>
                                    <th style="font-size:smaller; width:5%; background: lightgray;">Days</th>
                                    <th style="font-size:smaller; width:5%; background: lightgray;">Absent</th>
                                    <th style="font-size:smaller; width:5%;  background: lightgray;">Late</th>
                                    <th style="font-size:smaller; background: lightgray;">Undertime</th>
                                    <th style="font-size:smaller; background: lightgray;">Adj&nbsp;Day</th>
                                    <th style="font-size:smaller; background: lightgray;">Adj&nbsp;Absent</th>
                                    <th style="font-size:smaller; width:15%; background: lightgray;">Adj&nbsp;Late</th>
                                    <th style="font-size:smaller; width:15%; background: lightgray;">Adj&nbsp;Undertime</th>
                                </tr>
                            </thead>
                            @*<tfoot id="tfooter" style="background: gainsboro;">
                                <tr>
                                    <th colspan="10" style="text-align:right">Total:</th>
                                    <th></th>
                                </tr>
                            </tfoot>*@
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="AttList" tabindex="-1" role="dialog" aria-labelledby="AttListLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">
                    <span>Attendance List</span>
                </h6>
            </div>
            <div class="modal-body">
                <table id="AttendanceTable" class="table table-striped table-hover dt-responsive nowrap" style="padding: 10px;">
                    <thead>
                        <tr>
                            <th width="20%">Date</th>
                            <th width="40%">Timekeeping&nbsp;Code</th>
                            <th width="40%">Company</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Closed</button>
            </div>
        </div>
    </div>
</div>



