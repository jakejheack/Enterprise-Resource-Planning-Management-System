@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Rfq
@using ezinvmvc.App.Sales

@model RfqCreateModel
@{
    ViewBag.CurrentPageName = PageNames.RFQ_Create;
}
<style type="text/css">
    .ui-autocomplete {
        z-index: 2147483647;
    }
</style>
@section scripts
    {
    <script src="~/view-resources/Views/RFQ/Create.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <input type="text" id="h1" value="@Model.EmpId" hidden>
                    <div class="page-title">
                        <h1>Create RFQ</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    <button id="SaveRfqButton" class="btn btn-outline-primary btn-sm"><i class="fa fa-save"></i>&nbsp; Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body card-block">
                        <form id="RfqForm" name="RfqForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
                            <div class="row clearfix">
                                <div class="col-md-12  col-xl-12">
                                    <div class="card">
                                        <div class="card-body card-block">
                                            <div class="row">
                                                <div class="col-md-6  col-xl-6" style="display:none">
                                                    <div class="form-group">
                                                        <label for="RFQ">Company</label>
                                                        <div class="input-group">
                                                            <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6  col-xl-6">
                                                    <div class="form-group">
                                                        <label for="RFQ">Series</label>
                                                        <div class="input-group">
                                                            <select name="SeriesTypeId" id="Series" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label>Date</label>
                                                        <div class="input-group date" data-provide="datepicker" disabled>
                                                            <input type="text" name="TransactionTime" class="form-control date-picker" value='@System.DateTime.Now.ToString("MM/dd/yyyy")' required disabled>
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-calendar"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">

                                                <div class="col-md-6 col-xl-6 ">
                                                    <div class="form-group">
                                                        <label for="txtClient">From</label>
                                                        <select id="Type" name="Type" class="selectpicker form-control">
                                                            <option>Leads</option>
                                                            <option>Client</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-xl-6" id="divLead">
                                                    <div class="form-group">
                                                        <label for="RFQ">Lead</label>
                                                        <input type="hidden" id="LeadId" name="LeadId" required>
                                                        <input type="hidden" id="LeadCode" name="LeadCode" required>
                                                        <input type="text" id="Lead" name="Lead" placeholder="Type Ref. No./Name/Project to search" class="form-control" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label for="txtClient">Client Name</label>
                                                        <input type="hidden" id="ClientId" name="ClientId" required>
                                                        <input type="text" id="ClientName" name="Client" placeholder="Type Name to search" class="form-control" readonly required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-xl-6">
                                                    <label for="RFQ">Contact Person</label>
                                                    <div class="form-group">
                                                        <input type="hidden" id="ContactPersonId" name="ContactPersonId" required>
                                                        <input type="text" id="ContactPerson" name="ContactPerson" placeholder="Type Name to search" class="form-control" readonly required>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-xl-6 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Project Name</label>
                                                        <input id="ProjectName" class="form-control" type="text" name="ProjectName" readonly required maxlength="128">
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Deadline</label>

                                                        <div class="input-group date" data-provide="datepicker">
                                                            <input type="text" id="Deadlines" name="Deadlines" class="form-control date-picker" value='@System.DateTime.Now.ToString("MM/dd/yyyy")' required>
                                                            <div class="input-group-addon">
                                                                <i class="fa fa-calendar"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3 col-xl-3 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Tel no.</label>
                                                        <input id="Telno" class="form-control" type="text" name="Telno" readonly>
                                                    </div>
                                                </div>

                                                <div class="col-md-3 col-xl-3 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Phone Number</label>
                                                        <input id="Phone" class="form-control" type="text" name="Phone" readonly>
                                                    </div>
                                                </div>

                                                <div class="col-md-3 col-xl-3 " style="display:none">
                                                    <div class="form-group">
                                                        <label for="RFQ">Taxno</label>
                                                        <input id="Taxno" class="form-control" type="text" name="Taxno" readonly>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-xl-6 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Email</label>
                                                        <input id="Email" class="form-control" type="text" name="Email" readonly>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 col-xl-12 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Address</label>
                                                        <textarea id="Address" name="Address" class="form-control" rows="2" maxlength="328" readonly></textarea>
                                                        @*<input id="Address" class="form-control" type="text" name="Address" required>*@
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">

                                                <div class="col-md-12 col-xl-12 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Delivery Address</label>
                                                        <textarea id="DeliveryAddress" name="DeliveryAddress" class="form-control" rows="2" maxlength="328" required placeholder="Delivery Address 300 character only"></textarea>
                                                        @*<input id="DeliveryAddress" class="form-control" type="text" name="DeliveryAddress" required>*@
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-3 col-xl-3 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Discount</label>
                                                        <input type="text" id="Discount" name="Discount" class="form-control" required>
                                                    </div>
                                                </div>

                                                <div class="col-md-3 col-xl-3 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">VAT Type</label>
                                                        <select id="Vat" name="Vat" class="selectpicker form-control" required>
                                                            <option value="w/VAT">w/ VAT</option>
                                                            <option value="w/oVAT">w/o VAT</option>
                                                            <option value="Zero Rated">Zero Rated</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">

                                                <div class="col-md-12 col-xl-12 ">
                                                    <div class="form-group">
                                                        <label for="RFQ">Remarks</label>
                                                        <textarea id="Remarks" name="Remarks" class="form-control" rows="2" maxlength="328" placeholder="Remarks 300 character only" required></textarea>
                                                        @*<input id="DeliveryAddress" class="form-control" type="text" name="DeliveryAddress" required>*@
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @*<div class="row">
                                    <div class="col-md-12 col-xl-12 ">
                                        <div class="form-group">
                                            <label for="RFQ">List of Products</label>
                                        </div>
                                    </div>
                                </div>*@

                            <div class="row clearfix">
                                <div class="col-md-12  col-xl-12">
                                    <div class="card">
                                        <div class="card-body card-block">
                                            <div class="row">
                                                <div class="col-md-12  col-xl-12">
                                                    <div class="form-group">
                                                        <table id="ItemsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                            <thead>
                                                                <tr>
                                                                    @*<th width="5%">#</th>
                                                                    <th width="35%">Item</th>
                                                                    <th width="15%">Quantity</th>
                                                                    <th width="5%"></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>
                                                                    <th></th>*@
                                                                    <th width="5%">#</th>@*0*@
                                                                    <th width="35%">Item</th>@*1*@
                                                                    <th width="5%">Type</th>@*2 Option*@
                                                                    <th width="15%">Qty</th>@*[2] 3*@
                                                                    <th width="15%">Price</th>@*[3] 4 Price*@
                                                                    <th width="10%">Less</th>@*[4] 5 DiscTotal*@
                                                                    <th width="15%">Amount</th>@*[5] 6 Total*@
                                                                    <th width="5%"></th>@*[6] 7 Total*@
                                                                    <th></th>@*[7] 8 ProductId*@
                                                                    <th></th>@*[8] 9 Description*@
                                                                    <th></th>@*[9] 10 OrderQty*@
                                                                    <th></th>@*[10] 11 UnitId*@
                                                                    <th></th>@*[11] 12 Disc1*@
                                                                    <th></th>@*[12] 13 DiscType1*@
                                                                    <th></th>@*[13] 14 Disc2*@
                                                                    <th></th>@*[14] 15 DiscType2*@
                                                                    <th></th>@*[15] 16 Disc3*@
                                                                    <th></th>@*[16] 17 DiscType3*@
                                                                    <th></th>@*[17] 18 GroupName*@
                                                                    <th></th>@*[18] 19 Reference*@
                                                                    @**MARC qi_option 07212022*@
                                                                    <th></th>@*20 Option*@
                                                                    <th></th>@*21 Color*@
                                                                    @**MARC qi_option 07212022*@
                                                                </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 col-xl-12">
                                                    <div class="card border border-success" id="accordion">
                                                        <div class="card-header">
                                                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                                                                Add Item
                                                            </a>
                                                        </div>
                                                        <div id="collapseTwo" class="panel-collapse collapse in">
                                                            <div class="card-body">
                                                                <div class="row">
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Type</label>
                                                                            <select id="ItemType" name="ItemType" class="selectpicker form-control">
                                                                                <option value="1">Actual</option>
                                                                                <option value="0">Option</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Color</label>
                                                                            <input id="Color" name="Color" type="text" class="form-control" placeholder="Color 50 character only">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Name</label>
                                                                            <input id="ProductId" type="hidden">
                                                                            <input id="ProductName" type="text" class="form-control">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Code</label>
                                                                            <input id="ProductCode" type="text" class="form-control" readonly>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-3  col-xl-3">
                                                                        <div class="form-group">
                                                                            <label>Quantity</label>
                                                                            <input id="Quantity" type="text" name="Quantity" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3  col-xl-3">
                                                                        <div class="form-group">
                                                                            <label>Stocks</label>
                                                                            <input id="Stocks" type="text" class="form-control" readonly>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6 col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Unit</label>
                                                                            <select id="Units" class="selectpicker form-control" tabindex="-1" data-live-search="true"></select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-3 col-xl-3" hidden>
                                                                        <div class="form-group">
                                                                            <label>Price</label>
                                                                            <input id="Price" type="text" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">

                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="card" id="accordion">
                                                                            <div class="card-header">
                                                                                <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                                                                                    Add Discount
                                                                                </a>
                                                                            </div>
                                                                            <div id="collapseThree" class="panel-collapse collapse in">
                                                                                <div class="card-body">
                                                                                    <div class="row">
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Discount</label>
                                                                                                <input id="Discount1" type="text" value="0" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Type</label>
                                                                                                <select id="DiscountType1" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                                    <option value=2>Percent</option>
                                                                                                    <option value=1>Value</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="row">
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Discount</label>
                                                                                                <input id="Discount2" type="text" value="0" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Type</label>
                                                                                                <select id="DiscountType2" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                                    <option value=2>Percent</option>
                                                                                                    <option value=1>Value</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="row">
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Discount</label>
                                                                                                <input id="Discount3" type="text" value="0" class="form-control" onkeypress="return decimalOnly(this.id);">
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-6  col-xl-6">
                                                                                            <div class="form-group">
                                                                                                <label>Type</label>
                                                                                                <select id="DiscountType3" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                                                    <option value=2>Percent</option>
                                                                                                    <option value=1>Value</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="form-group">
                                                                            <label>Description</label>
                                                                            <textarea id="PerDescription" class="form-control" rows="5" maxlength="328"></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <label>Group Name/Area</label>
                                                                            <input id="GroupName" type="text" class="form-control" placeholder="64 Charater only">
                                                                        </div>

                                                                        <div class="form-group  text-right">
                                                                            <button id="AddItemButton" class="btn btn-outline-success btn-sm"><i class="fa fa-plus"></i>&nbsp; Add</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 col-xl-12">
                                                    <div class="card border border-success" id="accordion4">
                                                        <div class="card-header">
                                                            <a data-toggle="collapse" data-parent="#accordion4" href="#collapsefour">
                                                                Add MTO and Other item
                                                            </a>
                                                        </div>
                                                        <div id="collapsefour" class="panel-collapse collapse in">
                                                            <div class="card-body">
                                                                <div class="row">
                                                                    <div class="col-md-12  col-xl-12" hidden>
                                                                        <div class="form-group">
                                                                            <label>Others</label>
                                                                            <textarea id="Others" name="Others" class="form-control" rows="5" maxlength="3000"></textarea>
                                                                            <label>Count :</label><span id="characters"></span>

                                                                            <input id="Oitemno" name="Oitemno" type="hidden" class="form-control" placeholder="Color">
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-md-12  col-xl-12">
                                                                        <div class="form-group">
                                                                            <table id="OItemsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th style="width: 7%">No</th>@*0*@
                                                                                        <th style="width: 15%">Name</th>@*0*@
                                                                                        <th style="width: 10%">Area</th>@*1*@
                                                                                        <th style="width: 36%">Description</th>@*2 Option*@
                                                                                        <th style="width: 15%">Dimension</th>@*[2] 3*@
                                                                                        <th style="width: 10%">Qty</th>@*[3] 4 Price*@
                                                                                        <th style="width: 7%"></th>@*[6] 7 Total*@
                                                                                    </tr>
                                                                                </thead>
                                                                            </table>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <input id="OName" name="OName" type="text" class="form-control" placeholder="Name" maxlength="328">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <input id="OArea" name="OArea" type="text" class="form-control" placeholder="Area" maxlength="328">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-12  col-xl-12">
                                                                        <div class="form-group">
                                                                            <textarea id="ODescription" name="ODescription" type="text" class="form-control" placeholder="Description 800 character only" maxlength="800" rows="3"></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6  col-xl-6">
                                                                        <div class="form-group">
                                                                            <input id="ODimension" name="ODimension" type="text" class="form-control" placeholder="Dimension" maxlength="328">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4  col-xl-4">
                                                                        <div class="form-group">
                                                                            <input id="OQuantity" type="text" name="OQuantity" class="form-control" placeholder="Qty" onkeypress="return decimalOnly(this.id);">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-2  col-xl-2">
                                                                        <button id="OAddItemButton" class="btn btn-outline-success" style="width:100%"><i class="fa fa-plus"></i>&nbsp; Add</button>
                                                                        <button id="OUpdateItemButton" class="btn btn-outline-danger" style="width:100%"><i class="fa fa-plus"></i>&nbsp; Update</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Clientsmodal" tabindex="-1" role="dialog" aria-labelledby="ClientsModalLabel" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span>Contact Person</span>
                </h4>
            </div>
            @* Filter *@
            <div class="row align-items-center m--margin-bottom-10">
                <div class="col-md-2 col-xl-2">

                </div>
                <div class="col-md-2 col-xl-2">

                </div>
                <div class="col-md-6 col-xl-8">
                    <div class="input-group">
                        <input type="text" id="SearchFilter" class="form-control m-input" placeholder="Search..." />
                        <span class="input-group-btn">
                            <button id="SearchButton" class="btn btn-default" type="submit"><i class="fa fa-search" aria-label="@L("Search")"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            @* List *@
            <div class="row align-items-center">
                <div class="col-xl-12">
                    <table id="ClientsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                        <thead>
                            <tr>
                                <th></th>
                                <th width="15%">Code</th>
                                <th width="20%">Name</th>
                                @*<th width="10%">Type</th>
                                    <th width="15%">Industry</th>
                                    <th width="35%">Address</th>*@
                                <th width="0%">@L("Actions")</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">@L("Cancel")</button>
                @*<button type="submit" class="btn btn-primary waves-effect">@L("Save")</button>*@
            </div>
        </div>
