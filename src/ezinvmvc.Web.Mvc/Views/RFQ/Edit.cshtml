                                                        <label for="Product">Ref. No.</label>
                                                        <div class="input-group">
                                                            <input id="Id" class="form-control font-weight-bold" disabled type="hidden" name="Id" value="@ViewBag.Id" required>
                                                            <input id="RefNo" class="form-control font-weight-bold" disabled type="text" name="RefNo" required>
                                                            <input id="Series" type="hidden" name="SeriesTypeId">
                                                            <input id="Prefix" type="hidden" name="Prefix">
                                                            <input type="hidden" id="Code" name="Code" />
                                                            <input type="hidden" id="RevisionNo" name="RevisionNo" />
                                                            <input id="StatusId" type="hidden" name="StatusId">
                                                            <select name="CompanyId2" id="Companies" style="display:none"></select>
                                                            <input type="hidden" id="CompanyId" name="CompanyId" />
