@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.RFP

@model RFPCreateModel
@{
    //ViewData["Title"] = "RFQ";

    ViewBag.CurrentPageName = PageNames.RFP_Edit;

}
@section scripts
    {
    <script src="~/view-resources/Views/RFP/Edit.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <input type="text" id="h1" value="@Model.EmpId" hidden>

                    <div class="page-title">
                        <h1>
                            Edit RFP
                            <span id="StatusBadge"></span>
                        </h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_Rfp_Edit))
                    {
                        <button id="SaveButton" class="btn btn-outline-primary btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Update</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Rfp_Approve))
                    {
                        <button id="PreApprovedButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Approve</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

