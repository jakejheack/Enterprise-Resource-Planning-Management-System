@using ezinvmvc.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.PayrollRate;
}
@section scripts
    {
    <script src="~/view-resources/Views/EmployeeSalaryRates/PayrollRate.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Payroll Rate</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="text-right" style="padding-top:10px">
                    <button id="EmployeeList" data-toggle="modal" data-target="#EmployeeListModal" class="btn btn-outline-primary btn-lg"><i class="fa fa-list-ol"></i>&nbsp;Employees</button>
                    <button id="SaveRate" name="SaveRate" class="btn btn-outline-success btn-lg"><i class="fa fa-save"></i>&nbsp;Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <form name="form" role="form" novalidate class="form-validation">
                        @*Select Employee*@
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-2 col-xl-2">
                                    <label for="EmployeeCode">Employee Code</label>
                                    <input id="EmpCode" name="EmpCode" class="form-control" readonly required maxlength="128" placeholder="Employee Id">
                                </div>
                                <div class="col-md-10 col-xl-6">
                                    <label for="EmployeeName">Employee Name</label>
                                    <input id="completeName" name="completeName" type="text" class="form-control" readonly required maxlength="128" placeholder="Select Employee">
                                    <input id="EmpId" name="EmpId" type="hidden" class="form-control" required maxlength="128">
                                </div>
                                <div class="col-md-2 col-xl-4">
                                    <label for="EmployeeName">Employees Payroll Status</label>
                                    <select class="form-control selectpicker" id="SalaryPeriod" name="SalaryPeriod" required style=" background-color: #a1e7ff;font-weight: 600;"></select>
                                </div>
                            </div>
                        </div>
                        @*Select Employee*@

                        @*start Date Rates*@
                        <div class="row" style=" height: 8px;">
                        </div>
                        <div class="card-body" style=" background-color: antiquewhite;">
                            <div class="row">
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName">Employee Start Date Rate</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="">Start Date</span>
                                        </div>
                                        <input id="StartDate" name="StartDate" type="text" class="form-control form-control-md date-picker" required style=" background-color: #a1e7ff;font-weight: 600;">
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName">Employee End Date Rate</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="">End Date</span>
                                        </div>
                                        <input id="EndtDate" name="EndtDate" type="text" class="form-control input-lg form-control-md date-picker" required style=" background-color: #a1e7ff;font-weight: 600;">
                                    </div>
                                </div>

                                <div class="col-md-2 col-xl-2">
                                    <label for="EmployeeName">Payroll Period</label>
                                    <select class="form-control selectpicker" id="Period" name="Period" required style=" background-color: #a1e7ff;font-weight: 600;"></select>
                                </div>

                                <div class="col-md-2 col-xl-2" hidden>
                                    <label for="EmployeeName">W/Held</label>
                                    <div class="input-group">
                                        <input id="TaxWHeld" name="TaxWHeld" type="text" class="form-control" placeholder="0.00" style=" background-color: #a1e7ff;font-weight: 600;">
                                    </div>
                                </div>
                                <div class="col-md-2 col-xl-2" style=" padding-bottom: 15px;">
                                    <label for="EmployeeName">Rates</label>
                                    <div class="input-group">
                                        <input id="Rates" name="Rates" type="text" class="form-control" placeholder="0.00" required style=" background-color: #a1e7ff;font-weight: 600;">
                                    </div>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of Day a Year</label>
                                    <input id="aYear" name="aYear" type="text" class="form-control" value="313" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of Day a month</label>
                                    <input id="Amonth" name="Amonth" type="text" class="form-control" value="26.08" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of days half-month</label>
                                    <input id="halfmonth" name="halfmonth" type="text" class="form-control" value="13" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of days a Week</label>
                                    <input id="aWeek" name="aWeek" type="text" class="form-control" value="6" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of Hour a Day</label>
                                    <input id="aDay" name="aDay" type="text" class="form-control" value="8" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="EmployeeName"># Of Hour</label>
                                    <input id="aHour" name="aHour" type="text" class="form-control" value="1" required>
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="SL"># Of Sick Leave</label>
                                    <input id="SL" name="SL" type="text" class="form-control" value="7.5">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="VL"># Of Vacation Leave</label>
                                    <input id="VL" name="VL" type="text" class="form-control" value="7.5">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="TotalL">Total # Of Leave</label>
                                    <input id="TotalLeave" name="TotalLeave" type="text" class="form-control" value="15">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="PL"># Of Paternity Leave</label>
                                    <input id="PL" name="PL" type="text" class="form-control" value="7">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                    <label for="SIL"># of  SIL</label>
                                    <input id="SIL" name="SIL" type="text" class="form-control" value="5">
                                </div>
                                <div class="col-md-4 col-xl-4">
                                   
                                </div>
                            </div>
                        </div>
                        @*start Date Rates*@
                    </form>
                        @*Rates*@
                    <div class="card-body">
                        <div class="row">
                            <div class="container">
                                <ul id="tabs" class="nav nav-tabs" role="tablist">
                                    <li class="nav-item">
                                        <a id="tab-A" href="#pane-A" class="nav-link active" data-toggle="tab" role="tab" style="padding: 10px;">–Earning Rate–</a>
                                    </li>
                                    <li class="nav-item">
                                        <a id="tab-B" href="#pane-B" class="nav-link" data-toggle="tab" role="tab" style="padding: 10px;">–Time Sched–</a>
                                    </li>
                                    <li class="nav-item">
                                        <a id="tab-C" href="#pane-C" class="nav-link" data-toggle="tab" role="tab" style="padding: 10px;">–Contributions–</a>
                                    </li>
                                </ul>

                                <div id="content" class="tab-content" role="tablist">
                                    <div id="pane-A" class="card tab-pane fade show active" role="tabpanel" aria-labelledby="tab-A">
                                        <div class="card-header" role="tab" id="heading-A">
                                        </div>

                                        <!-- Note: New place of `data-parent` -->
                                        <div id="collapse-A" class="collapse show" data-parent="#content" role="tabpanel" aria-labelledby="heading-A">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-xl-6">
                                                        <div class="input-group mb-12">
                                                            <div class="input-group-prepend">
                                                                <label for="EmployeeName" data-toggle="modal" data-target="#CreateRateModal" class="btn btn-outline-secondary" readonly><i class="fa fa-plus"></i> New Rates Option</label>
                                                            </div>
                                                            <input id="Payrollrateid" name="Payrollrateid" type="text" class="form-control" hidden required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">
                                                            <select id="PayrollRate2" name="PayrollRate2" class="form-control selectpicker" data-live-search="true"></select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    @* RateList *@
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> Regural Rates</label>
                                                        <input id="Regural1" name="Regural1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> Rest Day</label>
                                                        <input id="RestDay1" name="RestDay1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> Special Holiday</label>
                                                        <input id="SpecialHoliday1" name="SpecialHoliday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> Legal Holiday</label>
                                                        <input id="LegalHoliday1" name="LegalHoliday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> SpHol Restday</label>
                                                        <input id="SpecialHolidayRestday1" name="SpecialHolidayRestday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-2"><i class="fa fa-check"></i> LgHol Restday</label>
                                                        <input id="LegalHolidayRestday1" name="LegalHolidayRestday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> Regural Rates OT</label>
                                                        <input id="ReguralOT1" name="ReguralOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> Rest Day OT</label>
                                                        <input id="RestDayOT1" name="RestDayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> Special Holiday OT</label>
                                                        <input id="SpecialHolidayOT1" name="SpecialHolidayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> Legal Holiday OT</label>
                                                        <input id="LegalHolidayOT1" name="LegalHolidayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> SpHol Restday OT</label>
                                                        <input id="SpecialHolidayRestdayOT1" name="SpecialHolidayRestdayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-1"><i class="fa fa-check"></i> LgHol Restday OT</label>
                                                        <input id="LegalHolidayRestdayOT1" name="LegalHolidayRestdayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND Basic Rates</label>
                                                        <input id="NDRegural1" name="NDRegural1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND Rest Day</label>
                                                        <input id="NDRestDay1" name="NDRestDay1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND Special Holiday</label>
                                                        <input id="NDSpecialHoliday1" name="NDSpecialHoliday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND Legal Holiday</label>
                                                        <input id="NDLegalHoliday1" name="NDLegalHoliday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND SpHol Restday</label>
                                                        <input id="NDSpecialHolidayRestday1" name="NDSpecialHolidayRestday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> ND LgHol Restday</label>
                                                        <input id="NDLegalHolidayRestday1" name="NDLegalHolidayRestday1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                    </div>

                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND Regural Rates O.T.</label>
                                                        <input id="NDReguralOT1" name="NDReguralOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND Rest Day O.T.</label>
                                                        <input id="NDRestDayOT1" name="NDRestDayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND Special Holiday O.T.</label>
                                                        <input id="NDSpecialHolidayOT1" name="NDSpecialHolidayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND Legal Holiday O.T.</label>
                                                        <input id="NDLegalHolidayOT1" name="NDLegalHolidayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND SpHol Restday O.T.</label>
                                                        <input id="NDSpecialHolidayRestdayOT1" name="NDSpecialHolidayRestdayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">

                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> ND LgHol Restday O.T.</label>
                                                        <input id="NDLegalHolidayRestdayOT1" name="NDLegalHolidayRestdayOT1" type="text" class="form-control" required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">
                                                    </div>

                                                    <div class="col-md-12 col-xl-12" style=" background-color: antiquewhite; padding-bottom: 10px;">
                                                        <table id="EmpSalaryTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th>Start</th>
                                                                    <th>End</th>
                                                                    <th>Monthly</th>
                                                                    <th>Daily</th>
                                                                    <th>Hour</th>
                                                                    <th>@L("Actions")</th>
                                                                </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                    @* RateList *@
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="pane-B" class="card tab-pane fade" role="tabpanel" aria-labelledby="tab-B">

                                        <div class="card-header" role="tab" id="heading-B">
                                        </div>

                                        <div id="collapse-B" class="collapse show" data-parent="#content" role="tabpanel" aria-labelledby="heading-B">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-xl-6">
                                                        <div class="input-group mb-12">
                                                            <div class="input-group mb-12">
                                                                <div class="input-group-prepend">
                                                                    <label for="EmployeeName" data-toggle="modal" data-target="#CreateTimeSchedModal" class="btn btn-outline-secondary" readonly><i class="fa fa-plus"></i> New Time Sched Option</label>
                                                                </div>
                                                                <input id="Timesched1id" name="Timesched1id" type="text" class="form-control" hidden required maxlength="256" placeholder="0.000" value="0.000" style="margin-bottom: 10px;">
                                                                <select id="Timesched1" name="Timesched1" class="form-control selectpicker" data-live-search="true"></select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card-body">

                                                <label for="EmployeeName"><i class="fa fa-clock-o"></i> TIME STATUS</label>
                                                <div class="row">
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> Flexi Time</label>
                                                        <select id="FlexitimeStatus1" name="FlexitimeStatus1" class="selectpicker form-control">
                                                            <option value='1'>Yes</option>
                                                            <option value='2' selected>No</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> With Overtime</label>
                                                        <select id="OTStatus1" name="OTStatus1" class="selectpicker form-control">
                                                            <option value='1' selected>Yes</option>
                                                            <option value='2'>No</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> Employee Type</label>
                                                        <select id="Workers" name="Workers" class="selectpicker form-control">
                                                            <option value='0' selected>Office Staff</option>
                                                            <option value='1'>Workers</option>
                                                            <option value='2'>Manager</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> Shift</label>
                                                        <select id="Shift" name="Shift" class="selectpicker form-control">
                                                            <option value='0' selected>Day Shift</option>
                                                            <option value='1'>Night Shift</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card-body">

                                                <label for="EmployeeName"><i class="fa fa-clock-o"></i> TIME IN / OUT</label>
                                                <div class="row">
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> A.M. IN</label>
                                                        <input id="amIn1" name="amIn1" class="form-control" type="time" placeholder="AM In 00:00" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> BREAK OUT</label>
                                                        <input id="breakOut1" name="breakOut1" class="form-control" type="time" placeholder="AM Out 00:00" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> BREAK IN</label>
                                                        <input id="breakIn1" name="breakIn1" class="form-control" type="time" placeholder="PM In 00:00" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> P.M. OUT</label>
                                                        <input id="pmOut1" name="pmOut1" class="form-control" type="time" placeholder="PM Out 00:00" required />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card-body">
                                                <label for="EmployeeName"><i class="fa fa-clock-o"></i> LATES</label>
                                                <div class="row">
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> A.M. Late In</label>
                                                        <input id="amLateIn1" name="amIn1" class="form-control" type="time" placeholder="00:05" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> A.M. Late End In</label>
                                                        <input id="amLAteEndIn1" name="amOut1" class="form-control" type="time" placeholder="00:15" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> P.M. Late In</label>
                                                        <input id="pmLateIn1" name="pmIn1" class="form-control" type="time" placeholder="00:05" required />
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-4"><i class="fa fa-check"></i> P.M. Late End In</label>
                                                        <input id="pmLateEndIn1" name="pmOut1" class="form-control" type="time" placeholder="00:15" required />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card-body">
                                                <label for="EmployeeName"><i class="fa fa-money"></i> RATE LATES / UNDERTIME</label>
                                                <div class="row">
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> Late Rates</label>
                                                        <input id="Laterate" name="Laterate" class="form-control" type="text" placeholder="0.000" required value="0.000" style=" background-color: #a1e7ff;font-weight: 600;">
                                                    </div>
                                                    <div class="col-md-3 col-xl-3">
                                                        <label for="EmployeeName" class="flat-color-3"><i class="fa fa-check"></i> Undertime Rates</label>
                                                        <input id="Undertime" name="Undertime" class="form-control" type="text" placeholder="0.000" required value="0.000" style=" background-color: #a1e7ff;font-weight: 600;">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="pane-C" class="card tab-pane fade" role="tabpanel" aria-labelledby="tab-C">
                                        <div class="card-header" role="tab" id="heading-C">
                                        </div>
