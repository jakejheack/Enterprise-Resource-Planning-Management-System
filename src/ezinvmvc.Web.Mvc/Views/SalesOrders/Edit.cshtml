                <div class="col-md-12  col-xl-12">
                    <div class="card">
                        <div class="card-body card-block">
                            <div class="row" hidden>
                                <select name="CompanyId" id="Companies" class="selectpicker form-control" tabindex="-1" data-live-search="true" required></select>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label for="Product">Series</label>
                                        <div class="input-group">
                                            <input id="Id" type="hidden" value="@ViewBag.Id" name="Id">
                                            <input id="StatusId" type="hidden" name="StatusId">
                                            <input id="Series" type="hidden" name="SeriesTypeId">
                                            <input id="Prefix" type="hidden" name="Prefix">
                                            <input id="CompanyAddress" type="hidden" name="CompanyAddress">

                                            <div class="input-group date" data-provide="datepicker">
                                                <input id="SalesOrderCode" class="form-control font-weight-bold" disabled type="text" name="Code" required>
                                                <div class="input-group-addon">
                                                    <i class="fa fa-key"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Date</label>
                                        <div class="input-group date" data-provide="datepicker">
                                            <input type="text" id="TransactionTime" name="TransactionTime" class="form-control date-picker" required readonly>
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
                                    <div class="form-group">
                                        <label>Quotation</label>
                                        <input id="Divisionname" type="hidden" value="1" name="Divisionname">
                                        <input id="QuotationId" type="hidden" value="1" name="QuotationId">
                                        <input id="RFQId" type="hidden" name="RFQId">
                                        <input id="RFQ" type="hidden" name="RFQ">
                                        <input id="RFQDiscount" type="hidden" name="RFQDiscount">
                                        <input id="QuotationCode" type="text" name="QuotationCode" class="form-control" placeholder="Type here" required disabled>
                                    </div>

                                </div>
                                <div class="col-md-6  col-xl-6">
                                    @*<div class="form-group">
                                            <label>Delivery Date</label>
                                            <div class="input-group date" data-provide="datepicker">
                                                <input type="text" id="DeliveryTime" name="DeliveryTime" class="form-control date-picker" required disabled>
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                            </div>

                                        </div>*@
                                    <div class="form-group">
                                        <label>Delivery Date</label>
                                        <div class="input-group">

                                            <input id="DeliveryTimeStatusSwitch" type="hidden" value="2" name="DeliveryTimeStatusSwitch">
                                            <input type="text" id="DeliveryTime" name="DeliveryTime" class="form-control date-picker" required disabled>
                                            <select id="DeliveryStatusTime" name="DeliveryStatusTime" class="form-control" tabindex="-1" data-live-search="false">
