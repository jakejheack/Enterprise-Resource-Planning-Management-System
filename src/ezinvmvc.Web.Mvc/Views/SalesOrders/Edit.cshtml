                                                    <i id="DeliveryStatusDateIcon" class="fa fa-check-square fa-lg " readonly></i>
                                                </button>
                                            </span>

                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-xl-6">
