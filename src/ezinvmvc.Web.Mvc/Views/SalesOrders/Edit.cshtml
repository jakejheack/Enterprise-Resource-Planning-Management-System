@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    ViewBag.CurrentPageName = PageNames.Sales_Orders_Edit;
}
@section scripts
    {
    <script src="~/view-resources/Views/SalesOrders/Edit.js" asp-append-version="true"></script>
}
<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Sales Order &nbsp;<span id="StatusBadge"></span></h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Create))
                    {
                        <button id="CreateNewButton" onclick="window.open('@Url.Action(" Create", "SalesOrders" )')" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create New</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Edit))
                    {
                        <button id="SaveButton" class="btn btn-outline-primary btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Update</button>
                        <button id="SubmitButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Submit</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_ForDelivery))
                    {
                        <button id="ForDeliveryButton" class="btn btn-outline-success btn-sm" hidden><i class="fa fa-save"></i>&nbsp; For Delivery</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Revision))
                    {
                        <button id="PreRevisionButton" class="btn btn-outline-warning btn-sm" hidden><i class="fa fa-save"></i>&nbsp; For Revision</button>
                        <button id="ReviseButton" class="btn btn-outline-danger btn-sm" hidden><i class="fa fa-save"></i>&nbsp; Revise</button>
                    }

                    @*<div id="PrintMenuButton" class="btn-group" role="group">
                    *@
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Export))
                    {
                        <button id="btnPrint" type="button" class="btn btn-outline-secondary btn-sm"><i class="fa fa-print"></i>&nbsp; Print</button>
                    }
                    @*<div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
                @*<a id="PrintButton" class="dropdown-item" href="#">&nbsp;&nbsp;Order</a>
                <a id="PrintActualButton" class="dropdown-item" href="#">&nbsp;&nbsp;Actual</a>
            </div>
        </div>*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <form id="SalesOrderForm" name="SalesOrderForm" enctype="multipart/form-data" role="form" novalidate class="form-validation">
