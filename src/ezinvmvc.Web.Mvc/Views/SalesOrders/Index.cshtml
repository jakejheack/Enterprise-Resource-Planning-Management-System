@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization

@{
    ViewBag.CurrentPageName = PageNames.Sales_Orders;
}
@section scripts
    {
    <script src="~/view-resources/Views/SalesOrders/Index.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Sales Orders</h1>
                        <input type="hidden" id="h1" value="@ViewBag.EmpId" />
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
                <div class="float-right" style="padding-top:10px">
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Export))
                    {
                        <button id="ExportToExcelButton" class="btn btn-outline-success btn-sm"><i class="fa fa-file-excel-o"></i>&nbsp;Export</button>
                    }
                    @if (IsGranted(PermissionNames.Pages_Sales_Orders_Create))
                    {
                        <button id="CreateNewButton" onclick="window.open('@Url.Action("Create", "SalesOrders")')" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create New</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        @* Filter *@
                        <div class="card" id="accordion">
                            <div class="card-header">
                                <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                                    Filter
                                </a>
                            </div>
                            <div id="collapseThree" class="panel-collapse collapse in">
                                <div class="card-body">
                                    <div class="row align-items-center m--margin-bottom-10">
                                        <div class="col-md-3 col-xl-3">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">From</label>
                                                <input type="text" id="DateFrom" name="DateFrom" class="input-sm form-control-sm form-control date-picker">
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-xl-3">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">To</label>
                                                <input type="text" id="DateTo" name="DateTo" class="input-sm form-control-sm form-control date-picker">
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-xl-3">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">Status</label>
                                                <select id="StatusTypes" class="selectpicker form-control input-sm form-control-sm" multiple data-live-search="true">
                                                    <option value="1" selected>Draft</option>
                                                    <option value="2" selected>Submitted</option>
                                                    <option value="3" selected>For Delivery</option>
                                                    <option value="4" selected>Delivered</option>
                                                    <option value="5" selected>Completed</option>
                                                    <option value="6" selected>For Revision</option>
                                                    <option value="7">Revised</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-xl-3">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">Transaction Code</label>
                                                <input type="text" id="SearchFilter" class="form-control m-input input-sm form-control-sm" placeholder="Id" value="">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row align-items-center m--margin-bottom-10">
                                        <div class="col-md-6 col-xl-6">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">Account Executive</label>
                                                @*<input type="text" id="SalesAgent" class="form-control m-input input-sm form-control-sm">*@
                                                <select id="AEs" class="selectpicker form-control input-sm form-control-sm" multiple data-live-search="true"></select>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-xl-6">
                                            <div class="form-group">
                                                <label style="margin-bottom:0px;">Client</label>
                                                <input type="text" id="Client" class="form-control m-input input-sm form-control-sm">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row align-items-center m--margin-bottom-10">
                                        <div class="col-md-6 col-xl-6">
                                        </div>
                                        <div class="col-md-3 col-xl-3">
                                        </div>
                                        <div class="col-md-3 col-xl-3">
                                            <div class="form-group" style="padding-top:20px;">
                                                <button id="SearchButton" class="btn btn-primary btn-block btn-sm" type="submit">Search</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                      
                        @* List *@
                        <div class="row align-items-center">
                            <div class="col-xl-12">
                                <table id="ListTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th width="10%">Id</th>@*Id*@
                                            <th width="25%">AE</th>
                                            <th width="25%">Client</th>
                                            <th width="10%">Date</th>@*Date*@
                                            <th width="10%">Delivery</th>@*Date*@
                                            <th width="10%">Status</th>
                                            <th width="10%">Total</th>
                                            <th width="10%">Billing Status</th>
                                            <th width="10%">Billed</th>
                                            <th width="10%">Balance</th>
                                            <th width="4%">@L("Actions")</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="col-xl-12" hidden>
                                <table id="ListTable2" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th width="10%">Id</th>@*Id*@
                                            <th width="25%">AE</th>
                                            <th width="25%">Client</th>
                                            <th width="10%">Date</th>@*Date*@
                                            <th width="10%">Delivery</th>@*Date*@
                                            <th width="10%">Status</th>
                                            <th width="10%">Total</th>
                                            <th width="10%">Billing Status</th>
                                            <th width="10%">Billed</th>
                                            <th width="10%">Balance</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


