@using Abp.Application.Services.Dto
@using ezinvmvc.Web.Startup
@using ezinvmvc.Authorization
@using ezinvmvc.Web.Models.Leads
@using ezinvmvc.App.Leads

@model LeadEditModel
@{
    ViewBag.CurrentPageName = PageNames.Leads_Details;
}
@section scripts
    {
    <script src="~/view-resources/Views/Leads/Details.js" asp-append-version="true"></script>
}

<div class="breadcrumbs">
    <div class="breadcrumbs-inner">
        <div class="row m-0">
            <div class="col-md-6 col-xl-6">
                <div class="page-header float-left">
                    <div class="page-title">
                        <h1>Lead Details</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-6">
            </div>
        </div>
    </div>
</div>
<div class="content">
    <div class="animated fadeIn">
        <div class="row clearfix">
            <div class="col-md-12 col-xl-12">
                <div class="card">
                    <div class="card-body card-block">
                        <div class="row clearfix">
                            <div class="col-md-12 col-xl-12">
                                <h4 class="font-weight-bold" style="font-size:1.5rem">
                                    Ref. No. : @Model.Lead.Code
                                    &nbsp;&nbsp;&nbsp;
                                    Project : @Model.Lead.Project
                                </h4>
                                <input type="hidden" id="LeadId" value="@Model.Lead.Id" />
                                <input type="hidden" id="LeadUpdateId" value="@Model.Lead.ULeadUpdateId" />
                                <input type="hidden" id="h1" value="@Model.EmpId" />
                                <input type="hidden" id="ProjectName" value="@Model.Lead.Project" />
                            </div>
                        </div>
                        <br />
                        <div class="row clearfix">
                            <div class="col-md-12 col-xl-12">
                                <div class="custom-tab">
                                    <nav>
                                        <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                            <a data-toggle="tab" href="#generalinfo" class="nav-item nav-link active show" role="tab" aria-controls="custom-nav-home" aria-selected="true">General Info</a>
                                            <a data-toggle="tab" href="#updates" class="nav-item nav-link" role="tab" aria-controls="custom-nav-home" aria-selected="false">Updates</a>
                                            @if (IsGranted(PermissionNames.Pages_Rfq))
                                            {
                                                <a id="liRFQ" class="nav-item nav-link" data-toggle="tab" role="tab" aria-controls="custom-nav-home" aria-selected="false" href="#rfq">RFQ</a>
                                            }
                                            @if (IsGranted(PermissionNames.Pages_Quotations))
                                            {
                                                <a id="liQuotation" class="nav-item nav-link" data-toggle="tab" role="tab" aria-controls="custom-nav-home" aria-selected="false" href="#quotation">Quotation</a>
                                            }
                                            @if (IsGranted(PermissionNames.Pages_Sales_Orders))
                                            {
                                                <a id="liSalesOrder" class="nav-item nav-link" data-toggle="tab" role="tab" aria-controls="custom-nav-home" aria-selected="false" href="#order">Sales Order</a>
                                            }
                                                <a hidden data-toggle="tab" href="#invoice">Sales Invoice</a>
                                                <a hidden data-toggle="tab" href="#documents">File Attachments</a>
                                            </div>
                                    </nav>
                                    <div class="tab-content pl-3 pt-2">
                                        <div class="tab-pane fade in active show" id="generalinfo">
                                            <div class="row">
                                                <div class="col-md-4 col-xl-4" hidden>
                                                    <div class="form-group">
                                                        <label for="Lead">Ref. No.</label>
                                                        <input id="Id" type="hidden" name="Id" value="@Model.Lead.Id">
                                                        <input type="hidden" id="CompanyId" name="CompanyId" value="@Model.Lead.CompanyId" />
                                                        <input type="hidden" id="SeriesTypeId" name="SeriesTypeId" value="@Model.Lead.SeriesTypeId" />
                                                        <input type="hidden" id="Prefix" name="Prefix" value="@Model.Lead.Prefix" />
                                                        <input type="hidden" id="Code" name="Code" value="@Model.Lead.Code" />
                                                        <input id="iCode" class="form-control" type="text" name="iCode" value="@Model.Lead.Code" readonly maxlength="128">
                                                    </div>
                                                </div>
                                                <div class="col-md-4  col-xl-4">
                                                    <div class="form-group">
                                                        <label>Date</label>
                                                        <div class="input-group date" id="datetimepicker2" data-target-input="nearest">
                                                            <input id="LeadDate" class="form-control datetimepicker-input" placeholder="mm/dd/yyyy" type="text" name="LeadDate" data-target="#datetimepicker2" value='@System.DateTime.Now.ToString("MM/dd/yyyy")'>
                                                            <div class="input-group-append" data-target="#datetimepicker2" data-toggle="datetimepicker">
                                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                            </div>
                                                        </div>
                                                        <span id="errDate" class="error" style="display:none">This field is required.</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-xl-4" style="display:none">&nbsp;</div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4 col-xl-4 " style="display:none">
                                                    <div class="form-group">
                                                        <label for="Lead">Type</label>
                                                        <select id="LeadType" name="LeadType" class="selectpicker form-control"></select>
                                                    </div>
                                                </div>
                                                <div class="col-md-7 col-xl-7 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Client</label>
                                                        <input id="ClientId" type="hidden" name="ClientId" value="@Model.Lead.ClientId" />
                                                        <input id="Name" class="validate form-control" type="text" name="Name" value="@Model.Lead.ClientName" required maxlength="256">
                                                    </div>
                                                </div>
                                                <div class="col-md-5 col-xl-5 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Contact Person</label>
                                                        <input id="ContactPersonId" type="hidden" name="ContactPersonId" value="@Model.Lead.ContactPersonId" />
                                                        <input id="ContactPerson" class="validate form-control" type="text" name="ContactPerson" value="@Model.Lead.ContactPerson" required maxlength="256">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4 col-xl-4">
                                                    <label for="Lead">Tel. No</label>
                                                    <input id="TelNo" class="form-control" type="text" name="TelNo" value="@Model.Lead.TelNo" readonly>
                                                </div>
                                                <div class="col-md-4 col-xl-4">
                                                    <label for="Lead">Fax No.</label>
                                                    <input id="FaxNo" class="form-control" type="text" name="FaxNo" value="@Model.Lead.FaxNo" readonly>
                                                </div>
                                                <div class="col-md-4 col-xl-4">
                                                    <label for="Lead">Mobile No.</label>
                                                    <input id="MobileNo" class="form-control" type="text" name="MobileNo" value="@Model.Lead.MobileNo" readonly>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <label for="Lead">Email</label>
                                                    <input id="Email" class="form-control" type="email" name="Email" value="@Model.Lead.Email" readonly>
                                                </div>
                                                <div class="col-md-6 col-xl-6 ">
                                                    &nbsp;
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-12 col-xl-12 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Address</label>
                                                        <textarea id="Address" name="Address" maxlength="328" class="form-control" asp-for="@Model.Lead.Address" readonly></textarea>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-8 col-xl-8 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Project</label>
                                                        <input id="Project" class="validate form-control" type="text" name="Project" value="@Model.Lead.Project" required maxlength="128">
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-xl-4 ">
                                                    &nbsp;
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 col-xl-6">
                                                    <label for="Lead">Source</label>
                                                    <select id="LeadSourceId" name="LeadSourceId" class="selectpicker form-control">
                                                        <option value=0>-- Select --</option>
                                                        @foreach (var item in Model.Sources)
                                                        {
                                                            if (item.Id == Model.Lead.LeadSourceId)
                                                            {
                                                                <option selected value="@item.Id">@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-4 col-xl-4 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Country</label>
                                                        <div class="input-group">
                                                            <select name="CountryId" id="lbCountries" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                <option value=0>-- Select --</option>
                                                            </select>
                                                            <span class="input-group-btn">
                                                                <button id="CreateCountryButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#CountryCreateModal">
                                                                    <i class="fa fa-plus"></i>
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-xl-4 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Province</label><div class="input-group">
                                                            <select name="ProvinceId" id="lbProvinces" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                <option value=0>-- Select Country --</option>
                                                            </select>
                                                            <span class="input-group-btn">
                                                                <button id="CreateProvinceButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#ProvinceCreateModal">
                                                                    <i class="fa fa-plus"></i>
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 col-xl-4 ">
                                                    <div class="form-group">
                                                        <label for="Lead">City</label>
                                                        <div class="input-group">
                                                            <select name="CityId" id="lbCities" class="selectpicker form-control" tabindex="-1" data-live-search="true">
                                                                <option value=0>-- Select Province --</option>
                                                            </select>
                                                            <span class="input-group-btn">
                                                                <button id="CreateCityButton" type="button" class="btn btn-default" data-toggle="modal" data-target="#CityCreateModal">
                                                                    <i class="fa fa-plus"></i>
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-6 col-xl-6">
                                                    <label for="Lead">Market Segmentation</label>
                                                    <select id="LDIndustryId" name="IndustryId" class="selectpicker form-control">
                                                        <option value=0>-- Select --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-6 col-xl-6">
                                                    <label for="Lead">Task</label>
                                                    <select id="LDLeadTaskId" name="LeadTaskId" class="selectpicker form-control">
                                                        <option value=0>-- Select --</option>
                                                        @foreach (var item in Model.Tasks)
                                                        {
                                                            if (item.Id == Model.Lead.LeadTaskId)
                                                            {
                                                                <option selected value="@item.Id">@item.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@item.Id">@item.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-12 col-xl-12 ">
                                                    <div class="form-group">
                                                        <label for="Lead">Notes</label>
                                                        <textarea id="LDNotes" name="Notes" maxlength="328" class="validate form-control" asp-for="@Model.Lead.Notes"></textarea>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-6 col-xl-6" style="display:none">
                                                    <div class="form-group">
                                                        <label for="Lead">Assigned To</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label for="Lead">Assigned To</label>
                                                        <input id="LDAssignedToId" type="hidden" name="AssignedToId" value="@Model.Lead.AssignedToId" />
                                                        <input id="LDAssignedTo" class="validate form-control" type="text" name="AssignedTo" value="@Model.Lead.AssignedTo" required maxlength="128">
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label for="Lead">Assigned Email</label>
                                                        <input id="LDAssignedToEmail" class="validate form-control" type="text" name="AssignedToEmail" value="@Model.Lead.AssignedToEmail">
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    <div class="form-group">
                                                        <label for="Lead">Next Contact Date</label>
                                                        <div class="input-group date" id="datetimepicker1" data-target-input="nearest">
                                                            <input id="LDNextContactDateTime" class="form-control datetimepicker-input" placeholder="mm/dd/yyyy hh:mm tt" type="text" name="NextContactDateTime" data-toggle="datetimepicker" data-target="#datetimepicker1" value="@Convert.ToDateTime(Model.Lead.NextContactDateTime).ToString("MM/dd/yyyy hh:mm tt")">
                                                            <div class="input-group-append" data-target="#datetimepicker1" data-toggle="datetimepicker">
                                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-xl-6">
                                                    &nbsp;
                                                </div>
                                            </div>

                                            <div class="row" hidden>
                                                <div class="col-md-4 col-xl-4">
                                                    <label for="Lead">Status</label>
                                                    <select id="LDStatusId" name="StatusId" class="selectpicker form-control">
                                                        <option value="1">Open</option>
                                                        <option value="2">Lead</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="tab-pane fade " id="updates">
                                            <div class="col-md-12 col-xl-12">
                                                <div class="col-md-12 col-xl-12">
                                                    <h5 style="display: none">Updates</h5>
                                                    <div class="text-right" style="padding-top:10px">
                                                    </div>
                                                </div>
                                                <div class="col-md-12 col-xl-12" style="display: none">
                                                    <div class="row align-items-center m--margin-bottom-10">
                                                        @if (Model.Lead.StatusId == 2)
                                                        {
                                                            if (IsGranted(PermissionNames.CRM_Leads_Updates))
                                                            {
                                                                <div class="col-md-12 col-xl-12" style="display: none">
                                                                    <div class="pull-right">
                                                                        <a id="openCP" onclick="toggleCP()" class="btn btn-sm btn-success">
                                                                            <span class="fa fa-sm fa-plus"></span>&nbsp;Add
                                                                        </a>
                                                                        <a id="closeCP" onclick="reToggleCP()" class="btn btn-sm btn-danger" style="display: none">
                                                                            <span class="fa fa-sm fa-close"></span>&nbsp;Cancel
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    </div>

                                                    <div id="divCP" class="col-md-12 col-xl-12" style="display: none">
                                                        <div class="col-md-4 col-xl-4">
                                                            <label>First Name: &nbsp;<span id="errcpfname" style="color: red;"></span></label>
                                                            <div class="input-group">
                                                                <div class="input-group-addon" style="padding: 0 0 0 0 !important; border: 0 !important;">
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-xl-12">
                                                                <label>Last Name: &nbsp;<span id="errcplname" style="color: red;"></span></label>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <label>Position: &nbsp;<span id="errcppos" style="color: red;"></span></label>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <label>Birthday: &nbsp;<span id="errcpbday" style="color: red;"></span></label>
                                                                <div class="form-group">
                                                                    <div class='input-group date datepicker'>
                                                                        <input type="text" id="txtBirthDate" class="form-control" name="date" />
                                                                        <span class="input-group-addon">
                                                                            <span class="glyphicon glyphicon-calendar"></span>
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <label>Tel. No.: &nbsp;<span id="errcptel" style="color: red;"></span></label>
                                                            </div>
                                                            <div class="col-sm-3">
                                                                <label>Mobile No.: &nbsp;<span id="errcpmob" style="color: red;"></span></label>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <label>Email: &nbsp;<span id="errcpemail" style="color: red;"></span></label>
                                                            </div>
                                                            <div class="col-sm-6">
                                                                <label>Status:</label>
                                                            </div>
                                                            <div class="col-sm-12" id="divSaveCP" style="text-align: right">
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                                @* Filter *@
                                                <div class="row align-items-center m--margin-bottom-10">
                                                    <div class="col-md-4 col-xl-4">
                                                        <button id="CreateUpdatesButton" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i>&nbsp; Create</button>
                                                    </div>
                                                    <div class="col-md-4 col-xl-4">

                                                    </div>
                                                    <div class="col-md-4 col-xl-4">
                                                        <div class="input-group">
                                                            <input type="text" id="UpdatesSearchFilter" class="form-control m-input" placeholder="Search...">
                                                            <span class="input-group-btn">
                                                                <button id="UpdatesSearchButton" class="btn btn-default" type="submit"><i class="fa fa-search" aria-label="@L("Search")"></i></button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* List *@
                                                <div class="row align-items-center">
                                                    <div class="col-xl-12">
                                                        <table id="UpdatesTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th width="10%">Date</th>
                                                                    <th width="25%">Task</th>
                                                                    <th width="40%">Notes</th>
                                                                    <th width="15%">Assigned To</th>
                                                                    <th width="10%">Next Contact Date</th>
                                                                </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @if (IsGranted(PermissionNames.Pages_Rfq))
                                        {
                                            <div class="tab-pane fade" id="rfq">
                                                <div class="col-md-12 col-xl-12">
                                                    <div class="col-sm-12" style="display:none">
                                                        <h5>RFQs</h5>
                                                    </div>
                                                    <div class="col-sm-12" style="display:none">
                                                        <div class="col-sm-12 hidden">
                                                            <div class="pull-right">
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="height-fluid" style="overflow: hidden">
                                                                <div class="gridview-container">

                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row align-items-center m--margin-bottom-10">
                                                        <div class="col-md-4 col-xl-4">
                                                            <div class="form-group">
                                                                <div class="input-group date" id="datetimepicker3" data-target-input="nearest">
                                                                    <input class="form-control input-sm form-control-sm datetimepicker-input" type="text" id="RfqDateFrom" value="@System.DateTime.Now.ToString("MM/dd/yyyy")" data-target="#datetimepicker3">
                                                                    <div class="input-group-append" data-target="#datetimepicker3" data-toggle="datetimepicker">
                                                                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4 col-xl-4">
                                                            <div class="form-group">
                                                                <div class="input-group date" id="datetimepicker4" data-target-input="nearest">
                                                                    <input class="form-control input-sm form-control-sm datetimepicker-input" type="text" id="RfqDateTo" value="@System.DateTime.Now.ToString("MM/dd/yyyy")" data-target="#datetimepicker4">
                                                                    <div class="input-group-append" data-target="#datetimepicker4" data-toggle="datetimepicker">
                                                                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-xl-4">
                                                            <div class="form-group">
                                                                <select id="RfqStatusTypes" class="selectpicker form-control input-sm form-control-sm" multiple data-live-search="true">
                                                                    <option value="" selected disabled>Status</option>
                                                                    <option value="1">Draft</option>
                                                                    <option value="2">Submitted</option>
                                                                    <option value="3">For Revision</option>
                                                                    <option value="4">Completed</option>
                                                                    <option value="5">Revised</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-xl-4">
                                                            <div class="form-group">
                                                                <select id="AEs1" class="selectpicker form-control input-sm form-control-sm" multiple data-live-search="true">
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 col-xl-4">
                                                            <div class="form-group">
                                                                <div class="input-group">
                                                                    <input type="text" id="RfqSearchFilter" class="form-control m-input input-sm form-control-sm" placeholder="Search...">
                                                                    <span class="input-group-btn">
                                                                        <button id="RfqSearchButton" class="btn btn-default btn-sm" type="submit"><i class="fa fa-search" aria-label="@L("Search")"></i></button>
                                                                        @*<button id="SearchButton" class="btn btn-default" type="submit"><i class="fa fa-search"></i></button>*@
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @* List *@
                                                    <div class="row align-items-center">
                                                        <div class="col-xl-12">
                                                            <table id="RfqTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                                                                <thead>
                                                                    <tr>
                                                                        <th></th>
                                                                        <th width="20%">Code</th>
                                                                        <th width="20%">Project Name</th>
                                                                        <th width="20%">Date</th>
                                                                        <th width="20%">Contact Person</th>
                                                                        <th width="20%">Email</th>
                                                                        <th width="15%">Status</th>
                                                                        <th width="5%">@L("Actions")</th>
                                                                        <th></th>@*Code Code*@
                                                                        <th></th>@*StatusId*@
                                                                    </tr>
                                                                </thead>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (IsGranted(PermissionNames.Pages_Quotations))
                                        {
                                            <div class="tab-pane fade " id="quotation">
                                                <div class="col-md-12 col-xl-12">
                                                    <div class="col-sm-12" style="display:none">
                                                        <div class="col-sm-12">
                                                            <h5>Quotations</h5>
                                                        </div>
